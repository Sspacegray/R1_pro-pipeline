#include "p2pl_icp.h"
#include "eskf.h"
#include "cloud_process_livox.h" // Livox 点云处理类
#include "cloud_process_rs.h"    // RS16 点云处理类
#include "global_relocalization/global_relocalization.h"
#include "localization_state/localization_state.h"
#include "pose_persistence/pose_persistence.h"
#include "pose_persistence/pose_save_policy.h"
#include "utility/utility.h"
#include <tf2/LinearMath/Quaternion.h>
#include <tf2/LinearMath/Transform.h>

// TF2 ROS 接口（广播器和监听器）
#include <tf2_ros/transform_broadcaster.h>
#include <tf2_ros/transform_listener.h>
#include <tf2_ros/buffer.h>
// 几何消息与 TF2 的转换工具（注意 .h → .hpp）
#include <tf2_geometry_msgs/tf2_geometry_msgs.hpp>

// 用于性能统计
#include <chrono>
#include <deque>
#include <algorithm>
#include <cmath>
#include <builtin_interfaces/msg/time.hpp>
#include <std_msgs/msg/empty.hpp>

// Sophus 用于去畸变
#include <sophus/se3.hpp>
#include <sophus/so3.hpp>

// 用于独立处理线程和信号处理
#include <csignal>
#include <thread>
#include <condition_variable>
#include <atomic>

using namespace std::chrono_literals;

// 全局退出标志,用于信号处理
std::atomic<bool> g_b_exit(false);

// 信号处理函数
void SigHandle(int sig)
{
    g_b_exit.store(true);
    RCLCPP_WARN(rclcpp::get_logger("lidar_location_3d"), "捕获信号 %d, 准备退出...", sig);
    if (rclcpp::ok()) {
        rclcpp::shutdown();
    }
}

bool check_imu_data(Eigen::VectorXd imu_data)
{
    bool is_ok = true;
    if (std::abs(imu_data(0)) > 10000.0)
        is_ok = false;
    if (std::abs(imu_data(1)) > 10000.0)
        is_ok = false;
    if (std::abs(imu_data(2)) > 10000.0)
        is_ok = false;
    if (std::abs(imu_data(3)) > 10000.0)
        is_ok = false;
    if (std::abs(imu_data(4)) > 10000.0)
        is_ok = false;
    if (std::abs(imu_data(5)) > 10000.0)
        is_ok = false;
    return is_ok;
}

class location
{
public:
    rclcpp::Node::SharedPtr nh_ = std::make_shared<rclcpp::Node>("lidar_location_3d"); // ROS2 节点对象
    std::string map_file_path;                                                         // 地图路径
    pcl::PointCloud<PointType>::Ptr map_cloud;                                         // 地图点云
    pose_type act_pose;                                                                // 当前位姿
    pose_type init_pose_;                                                              // 初始位姿
    pose_type imu2base_pose;                                                           // imu到baselink相对位姿

    // ROS2 中定义消息
    sensor_msgs::msg::PointCloud2 pubmap_msg; // 作为消息播放的地图

    // 发布者
    rclcpp::Publisher<sensor_msgs::msg::PointCloud2>::SharedPtr pc_map_pub_;
    rclcpp::Publisher<sensor_msgs::msg::PointCloud2>::SharedPtr processed_cloud_pub_; // 处理后点云发布器
    rclcpp::Publisher<geometry_msgs::msg::PoseStamped>::SharedPtr pose_pub_;
    rclcpp::Publisher<nav_msgs::msg::Odometry>::SharedPtr odom2map_pub_;
    rclcpp::Publisher<indoor_location::msg::LocalizationStatus>::SharedPtr status_pub_;
    rclcpp::Publisher<std_msgs::msg::Empty>::SharedPtr reset_visibility_graph_pub_;
    //  订阅者
    rclcpp::Subscription<sensor_msgs::msg::PointCloud2>::SharedPtr cloud_sub_;
    rclcpp::Subscription<sensor_msgs::msg::Imu>::SharedPtr imu_sub_;
    rclcpp::Subscription<std_msgs::msg::String>::SharedPtr cmd_sub_;
    rclcpp::Subscription<geometry_msgs::msg::PoseWithCovarianceStamped>::SharedPtr init_pose_sub_;

    // tf 广播器
    std::shared_ptr<tf2_ros::TransformBroadcaster> tf_broadcaster_;
    std::shared_ptr<tf2_ros::Buffer> tf_buffer_;
    std::shared_ptr<tf2_ros::TransformListener> tf_listener_;

    pcl::VoxelGrid<PointType> map_voxelgrid_filter_; // 地图点云体素滤波器

    std::unique_ptr<scan2map3d> localizier3d;
    std::unique_ptr<ErrorStateKalmanFilter> eskf; // 误差状态卡尔曼滤波
    std::unique_ptr<GlobalRelocalization> global_relocalizer_;
    PosePersistence pose_persistence_;

    // IMU数据结构（与lio_node保持一致）
    struct IMUData
    {
        EIGEN_MAKE_ALIGNED_OPERATOR_NEW
        Eigen::Vector3d acc;
        Eigen::Vector3d gyro;
        double time;
        IMUData() = default;
        IMUData(const Eigen::Vector3d &a, const Eigen::Vector3d &g, const double &t)
            : acc(a), gyro(g), time(t) {}
    };

    // 同步数据包结构（与lio_node保持一致）
    struct SyncPackage
    {
        std::vector<IMUData> imus;
        pcl::PointCloud<PointType>::Ptr cloud;
        double cloud_start_time = 0.0;
        double cloud_end_time = 0.0;
    };

    // 状态数据结构（与lio_node保持一致）
    struct StateData
    {
        bool lidar_pushed = false;
        std::mutex imu_mutex;
        std::mutex lidar_mutex;
        double last_lidar_time = -1.0;
        double last_imu_time = -1.0;
        std::deque<IMUData> imu_buffer;
        std::deque<std::pair<double, pcl::PointCloud<PointType>::Ptr>> lidar_buffer;
    };

    StateData m_state_data;
    SyncPackage m_package;

    // 调试计数器
    int imu_cb_count_ = 0;
    int lidar_cb_count_ = 0;

    // 时间同步诊断开关
    bool enable_sync_debug_ = true;

    // ========== 点云预处理对象 ==========
    std::unique_ptr<cloud_process_livox> livox_processor_; // Livox点云处理对象
    std::unique_ptr<cloud_process> rs16_processor_;        // RS16点云处理对象
    std::string lidar_type_;                               // 雷达类型: "livox" 或 "rs16"

    int count_maplost_ = 0;
    bool use_reloc_ = false; // 是否使用重定位？

    float reloc_threshold_ = 0.0; // 重定位的匹配度阈值
    float tracking_threshold_ = 0.15f; // 正常定位模式下的最低匹配度阈值
    bool auto_reloc_on_tracking_loss_ = false; // 正常定位失败时是否自动切回重定位
    bool use_tracking_mode_ = true; // 是否在重定位稳定后切到 normal mode
    int reloc_confirm_frames_ = 2; // 连续满足重定位阈值多少帧后切正常模式
    int tracking_loss_frames_ = 5; // 正常定位连续丢失多少帧后切回重定位
    int reloc_success_count_ = 0;
    int tracking_loss_count_ = 0;
    float reloc_stability_pos_threshold_ = 1.0f; // 重定位确认时相邻候选位姿的最大位置差
    float reloc_stability_yaw_threshold_deg_ = 20.0f; // 重定位确认时相邻候选位姿的最大偏航差
    pose_type last_reloc_candidate_pose_;
    bool has_last_reloc_candidate_ = false;
    bool disable_runtime_reloc_after_init_ = true;
    bool initial_global_alignment_done_ = false;
    bool runtime_reloc_locked_ = false;
    bool has_last_valid_map_to_odom_ = false;
    bool freeze_map_to_odom_after_init_ = true;
    double map_to_odom_max_translation_step_m_ = 0.20;
    double map_to_odom_max_yaw_step_deg_ = 2.0;
    geometry_msgs::msg::TransformStamped last_valid_map_to_odom_;
    bool motion_state_initialized_ = false;
    bool last_motion_is_stationary_ = true;
    Eigen::Vector3f last_motion_eval_pos_ = Eigen::Vector3f::Zero();
    float last_motion_eval_yaw_ = 0.0f;
    double last_motion_eval_time_ = 0.0;
    const double stationary_linear_speed_threshold_mps_ = 0.08;
    const double stationary_yaw_rate_threshold_radps_ = 0.12;

    double voxel_leaf_size_ = 0.0, imu_scale_ = 0.0;
    double last_cloud_time_ = 0.0; // 上次点云时间戳

    Eigen::Matrix3f imu2link_rot_; // imu2link的旋转矩阵

    std::string map_frame_, odom_frame_, base_frame_;
    std::string odom2map_topic_;
    std::string reset_visibility_graph_topic_;
    bool publish_reset_visibility_graph_on_reloc_success_ = true;
    indoor_location::LocalizationState localization_state_ = indoor_location::LocalizationState::kUninitialized;
    bool map_to_odom_frozen_ = false;
    bool wheel_odom_available_ = false;
    bool pose_restored_from_disk_ = false;
    bool restored_pose_pending_ = false;
    bool use_wheel_odom_prior_ = true;
    bool enable_pose_restore_ = true;
    bool pose_save_only_when_stable_ = true;
    double pose_save_interval_sec_ = 1.0;
    double pose_save_max_interval_sec_ = 10.0;
    double pose_save_min_translation_m_ = 0.3;
    double pose_save_min_yaw_deg_ = 10.0;
    double last_pose_save_time_ = -1.0;
    std::string last_pose_source_ = "init";
    pose_type last_saved_pose_;
    bool has_last_saved_pose_ = false;
    PoseSavePolicy::Config pose_save_policy_config_;
    bool enable_bounded_global_reloc_window_ = true;

    // ============ 性能统计相关变量 ============
    struct PerformanceStats
    {
        // 处理耗时统计
        double imu_predict_time_ms = 0.0;        // IMU预测耗时
        double cloud_registration_time_ms = 0.0; // 点云配准耗时
        double eskf_correct_time_ms = 0.0;       // ESKF校正耗时
        double pose_publish_time_ms = 0.0;       // 位姿发布耗时
        double total_process_time_ms = 0.0;      // 总处理时间

        // 时间同步信息
        bool sync_success = false;     // 同步是否成功
        double lidar_start_time = 0.0; // 雷达起始时间
        double lidar_end_time = 0.0;   // 雷达结束时间
        double imu_first_time = 0.0;   // 同步后的IMU首帧时间
        double imu_last_time = 0.0;    // 同步后的IMU末帧时间
        int imu_count = 0;             // 同步的IMU数量

        // 调试信息：缓冲区状态
        size_t imu_buffer_before_sync = 0;  // 同步前IMU缓冲区大小
        double imu_buffer_first_time = 0.0; // 缓冲区中第一个IMU时间
        double imu_buffer_last_time = 0.0;  // 缓冲区中最后一个IMU时间
    };

    std::deque<PerformanceStats> perf_history_; // 性能历史记录（用于计算平均值）
    const size_t perf_history_size_ = 50;       // 保留最近50帧的数据

    rclcpp::Time last_pose_publish_time_; // 上次位姿发布时间
    int pose_publish_count_ = 0;          // 位姿发布计数
    rclcpp::Time stats_start_time_;       // 统计开始时间
    bool seeded_from_odom_tf_ = false;    // 是否已使用 odom TF 初始化位姿

    rclcpp::TimerBase::SharedPtr stats_timer_; // 定时器，用于定期输出统计信息

    // ============ 独立处理线程相关变量 ============
    std::thread process_thread_;                    // 独立处理线程
    std::mutex process_mutex_;                      // 处理线程同步互斥锁
    std::condition_variable process_cv_;            // 条件变量,用于唤醒处理线程
    // 注意: 使用syncPackage()作为唤醒条件,不需要额外的标志位

    // ============ 去畸变相关变量 ============
    Sophus::SE3d T_i_l_;            // IMU到LiDAR的外参变换
    bool enable_undistort_ = false; // 是否启用去畸变功能（暂时禁用）
    int undistort_count_ = 0;       // 去畸变帧计数

    location(rclcpp::Node::SharedPtr nh) : nh_(nh)
    {
        YAML::Node config;
        nh_ = nh;
        tf_broadcaster_ = std::make_shared<tf2_ros::TransformBroadcaster>(nh_); // 初始化 tf 广播器
        tf_buffer_ = std::make_shared<tf2_ros::Buffer>(nh_->get_clock());
        tf_listener_ = std::make_shared<tf2_ros::TransformListener>(*tf_buffer_);

        RCLCPP_INFO(nh->get_logger(), "\n--- Loaded location Parameters ---");
        std::string config_file_name;
        nh->declare_parameter<std::string>("config_file", "none");
        nh_->get_parameter("config_file", config_file_name);
        RCLCPP_INFO(nh_->get_logger(), "Loc: config file: %s", config_file_name.c_str());

        // 读取yaml数据
        try
        {
            config = YAML::LoadFile(config_file_name);
        }
        catch (YAML::BadFile &e)
        {
            RCLCPP_ERROR(nh_->get_logger(), "Loc :  read config file error!");
            return;
        }

        // 是否使用重定位
        use_reloc_ = config["use_reloc"].as<bool>();
        RCLCPP_INFO(nh_->get_logger(), "use_reloc %d", use_reloc_);

        imu_scale_ = config["imu_scale"].as<double>();
        RCLCPP_INFO(nh_->get_logger(), "imu_scale %f", imu_scale_);

        reloc_threshold_ = config["reloc_threshold"].as<float>();
        RCLCPP_INFO(nh_->get_logger(), "reloc_threshold %f", reloc_threshold_);
        tracking_threshold_ = config["tracking_threshold"] ? config["tracking_threshold"].as<float>() : 0.15f;
        RCLCPP_INFO(nh_->get_logger(), "tracking_threshold %f", tracking_threshold_);
        auto_reloc_on_tracking_loss_ = config["auto_reloc_on_tracking_loss"] ? config["auto_reloc_on_tracking_loss"].as<bool>() : false;
        RCLCPP_INFO(nh_->get_logger(), "auto_reloc_on_tracking_loss %d", auto_reloc_on_tracking_loss_);
        use_tracking_mode_ = config["use_tracking_mode"] ? config["use_tracking_mode"].as<bool>() : true;
        RCLCPP_INFO(nh_->get_logger(), "use_tracking_mode %d", use_tracking_mode_);
        reloc_confirm_frames_ = config["reloc_confirm_frames"] ? config["reloc_confirm_frames"].as<int>() : 2;
        tracking_loss_frames_ = config["tracking_loss_frames"] ? config["tracking_loss_frames"].as<int>() : 5;
        reloc_stability_pos_threshold_ = config["reloc_stability_pos_threshold"] ? config["reloc_stability_pos_threshold"].as<float>() : 1.0f;
        reloc_stability_yaw_threshold_deg_ = config["reloc_stability_yaw_threshold_deg"] ? config["reloc_stability_yaw_threshold_deg"].as<float>() : 20.0f;
        disable_runtime_reloc_after_init_ =
            config["disable_runtime_reloc_after_init"] ? config["disable_runtime_reloc_after_init"].as<bool>() : true;
        freeze_map_to_odom_after_init_ =
            config["freeze_map_to_odom_after_init"] ? config["freeze_map_to_odom_after_init"].as<bool>() : true;
        map_to_odom_max_translation_step_m_ =
            config["map_to_odom_max_translation_step_m"] ? config["map_to_odom_max_translation_step_m"].as<double>() : 0.20;
        map_to_odom_max_yaw_step_deg_ =
            config["map_to_odom_max_yaw_step_deg"] ? config["map_to_odom_max_yaw_step_deg"].as<double>() : 2.0;
        use_wheel_odom_prior_ =
            config["use_wheel_odom_prior"] ? config["use_wheel_odom_prior"].as<bool>() : true;
        enable_pose_restore_ =
            config["enable_pose_restore"] ? config["enable_pose_restore"].as<bool>() : true;
        pose_save_only_when_stable_ =
            config["pose_save_only_when_stable"] ? config["pose_save_only_when_stable"].as<bool>() : true;
        pose_save_interval_sec_ =
            config["pose_save_interval_sec"] ? config["pose_save_interval_sec"].as<double>() : 1.0;
        pose_save_max_interval_sec_ =
            config["pose_save_max_interval_sec"] ? config["pose_save_max_interval_sec"].as<double>() : 10.0;
        pose_save_min_translation_m_ =
            config["pose_save_min_translation_m"] ? config["pose_save_min_translation_m"].as<double>() : 0.3;
        pose_save_min_yaw_deg_ =
            config["pose_save_min_yaw_deg"] ? config["pose_save_min_yaw_deg"].as<double>() : 10.0;
        enable_bounded_global_reloc_window_ =
            config["enable_bounded_global_reloc_window"] ? config["enable_bounded_global_reloc_window"].as<bool>() : true;
        RCLCPP_INFO(nh_->get_logger(), "reloc_confirm_frames %d", reloc_confirm_frames_);
        RCLCPP_INFO(nh_->get_logger(), "tracking_loss_frames %d", tracking_loss_frames_);
        RCLCPP_INFO(nh_->get_logger(), "reloc_stability_pos_threshold %f", reloc_stability_pos_threshold_);
        RCLCPP_INFO(nh_->get_logger(), "reloc_stability_yaw_threshold_deg %f", reloc_stability_yaw_threshold_deg_);
        RCLCPP_INFO(nh_->get_logger(), "disable_runtime_reloc_after_init %d", disable_runtime_reloc_after_init_);
        RCLCPP_INFO(nh_->get_logger(), "freeze_map_to_odom_after_init %d", freeze_map_to_odom_after_init_);
        RCLCPP_INFO(nh_->get_logger(), "map_to_odom_max_translation_step_m %f", map_to_odom_max_translation_step_m_);
        RCLCPP_INFO(nh_->get_logger(), "map_to_odom_max_yaw_step_deg %f", map_to_odom_max_yaw_step_deg_);
        RCLCPP_INFO(nh_->get_logger(), "use_wheel_odom_prior %d", use_wheel_odom_prior_);
        RCLCPP_INFO(nh_->get_logger(), "enable_pose_restore %d", enable_pose_restore_);
        RCLCPP_INFO(nh_->get_logger(), "pose_save_only_when_stable %d", pose_save_only_when_stable_);
        RCLCPP_INFO(nh_->get_logger(), "pose_save_interval_sec %f", pose_save_interval_sec_);
        RCLCPP_INFO(nh_->get_logger(), "pose_save_max_interval_sec %f", pose_save_max_interval_sec_);
        RCLCPP_INFO(nh_->get_logger(), "pose_save_min_translation_m %f", pose_save_min_translation_m_);
        RCLCPP_INFO(nh_->get_logger(), "pose_save_min_yaw_deg %f", pose_save_min_yaw_deg_);

        pose_save_policy_config_.interval_sec = pose_save_interval_sec_;
        pose_save_policy_config_.max_interval_sec = pose_save_max_interval_sec_;
        pose_save_policy_config_.min_translation_m = pose_save_min_translation_m_;
        pose_save_policy_config_.min_yaw_deg = pose_save_min_yaw_deg_;
        RCLCPP_INFO(nh_->get_logger(), "enable_bounded_global_reloc_window %d", enable_bounded_global_reloc_window_);
        initial_global_alignment_done_ = !use_reloc_;
        runtime_reloc_locked_ = initial_global_alignment_done_ && disable_runtime_reloc_after_init_;

        base_frame_ = nh_->declare_parameter<std::string>("base_frame", config["base_frame"].as<std::string>());
        map_frame_ = nh_->declare_parameter<std::string>("map_frame", config["map_frame"].as<std::string>());
        odom_frame_ = nh_->declare_parameter<std::string>(
            "odom_frame",
            config["odom_frame"] ? config["odom_frame"].as<std::string>() : "odom");
        RCLCPP_INFO(
            nh_->get_logger(),
            "base_frame_: %s, odom_frame_: %s, map_frame_: %s",
            base_frame_.c_str(),
            odom_frame_.c_str(),
            map_frame_.c_str());

        // ========== 根据雷达类型初始化对应的点云处理对象 ==========
        lidar_type_ = config["lidar_type"].as<std::string>(); // "livox" 或 "rs16"
        double filter_leaf_size = config["filter_leaf_size"].as<double>();

        // lidar到base的变换
        Eigen::Vector3f lidar2base_rpy;
        lidar2base_rpy(0) = static_cast<float>(nh_->declare_parameter<double>("lidar2base_roll", config["lidar2base_roll"].as<double>()));
        lidar2base_rpy(1) = static_cast<float>(nh_->declare_parameter<double>("lidar2base_pitch", config["lidar2base_pitch"].as<double>()));
        lidar2base_rpy(2) = static_cast<float>(nh_->declare_parameter<double>("lidar2base_yaw", config["lidar2base_yaw"].as<double>()));

        Eigen::Vector3f lidar2base_trans;
        lidar2base_trans(0) = static_cast<float>(nh_->declare_parameter<double>("lidar2base_x", config["lidar2base_x"].as<double>()));
        lidar2base_trans(1) = static_cast<float>(nh_->declare_parameter<double>("lidar2base_y", config["lidar2base_y"].as<double>()));
        lidar2base_trans(2) = static_cast<float>(nh_->declare_parameter<double>("lidar2base_z", config["lidar2base_z"].as<double>()));

        Eigen::Matrix3f lidar2base_rot = RPY2Mat(lidar2base_rpy);
        RCLCPP_INFO(nh_->get_logger(), "雷达类型: %s", lidar_type_.c_str());
        RCLCPP_INFO(nh_->get_logger(), "Lidar2base: trans=(%.2f, %.2f, %.2f), rpy=(%.2f, %.2f, %.2f)",
                    lidar2base_trans(0), lidar2base_trans(1), lidar2base_trans(2),
                    lidar2base_rpy(0), lidar2base_rpy(1), lidar2base_rpy(2));
        if (lidar_type_ == "livox")
        {
            // 初始化 Livox 处理器
            livox_processor_.reset(new cloud_process_livox(filter_leaf_size));
            livox_processor_->N_SCANS_ = config["N_SCANS"].as<int>();
            livox_processor_->min_range_ = config["min_range"].as<double>();
            livox_processor_->max_range_ = config["max_range"].as<double>();
            livox_processor_->min_angle_ = config["limit_angle_min"].as<double>() * Deg2Rad;
            livox_processor_->max_angle_ = config["limit_angle_max"].as<double>() * Deg2Rad;
            livox_processor_->base2link_rot = lidar2base_rot;
            livox_processor_->base2link_trans = lidar2base_trans;

            RCLCPP_INFO(nh_->get_logger(), "Livox 点云处理器初始化完成: leaf_size=%.2f, range=[%.1f, %.1f], scans=%d",
                        filter_leaf_size, livox_processor_->min_range_, livox_processor_->max_range_,
                        livox_processor_->N_SCANS_);
        }
        else if (lidar_type_ == "rs16")
        {
            // 初始化 RS16 处理器
            rs16_processor_.reset(new cloud_process(filter_leaf_size));
            rs16_processor_->n_scans_ = config["N_SCANS"].as<uint16_t>();
            rs16_processor_->horizon_n_scans_ = config["Horizon_SCAN"].as<uint16_t>();
            rs16_processor_->min_range_ = config["min_range"].as<double>();
            rs16_processor_->max_range_ = config["max_range"].as<double>();
            rs16_processor_->min_angle_ = config["limit_angle_min"].as<double>() * Deg2Rad;
            rs16_processor_->max_angle_ = config["limit_angle_max"].as<double>() * Deg2Rad;
            rs16_processor_->lidar_low_angle_ = config["lidar_low_angle"].as<float>();
            rs16_processor_->lidar_angle_res_x_ = config["lidar_angle_res_x"].as<float>();
            rs16_processor_->lidar_angle_res_y_ = config["lidar_angle_res_y"].as<float>();
            rs16_processor_->base2link_rot = lidar2base_rot;
            rs16_processor_->base2link_trans = lidar2base_trans;

            RCLCPP_INFO(nh_->get_logger(), "RS16 点云处理器初始化完成: leaf_size=%.2f, range=[%.1f, %.1f], scans=%d",
                        filter_leaf_size, rs16_processor_->min_range_, rs16_processor_->max_range_,
                        rs16_processor_->n_scans_);
        }
        else
        {
            RCLCPP_ERROR(nh_->get_logger(), "未知的雷达类型: %s,仅支持 'livox' 或 'rs16'", lidar_type_.c_str());
            return;
        }

        // 初始化imu到baselink的转置矩阵
        imu2base_pose.pos(0) = static_cast<float>(nh_->declare_parameter<double>("imu2base_x", config["imu2base_x"].as<double>()));
        imu2base_pose.pos(1) = static_cast<float>(nh_->declare_parameter<double>("imu2base_y", config["imu2base_y"].as<double>()));
        imu2base_pose.pos(2) = static_cast<float>(nh_->declare_parameter<double>("imu2base_z", config["imu2base_z"].as<double>()));
        imu2base_pose.orient(0) = static_cast<float>(nh_->declare_parameter<double>("imu2base_roll", config["imu2base_roll"].as<double>()));
        imu2base_pose.orient(1) = static_cast<float>(nh_->declare_parameter<double>("imu2base_pitch", config["imu2base_pitch"].as<double>()));
        imu2base_pose.orient(2) = static_cast<float>(nh_->declare_parameter<double>("imu2base_yaw", config["imu2base_yaw"].as<double>()));
        RCLCPP_INFO(nh_->get_logger(), "Loc: imu2base_pose: %f, %f, %f, %f, %f, %f", imu2base_pose.pos(0), imu2base_pose.pos(1), imu2base_pose.pos(2), imu2base_pose.orient(0), imu2base_pose.orient(1), imu2base_pose.orient(2));
        update_q(imu2base_pose);
        imu2link_rot_ = RPY2Mat(imu2base_pose.orient); // imu到baselink的旋转矩阵

        RCLCPP_INFO(nh_->get_logger(), "Base to Link Rotation Matrix:\n [%f, %f, %f;\n %f, %f, %f;\n %f, %f, %f]",
                    imu2link_rot_(0, 0), imu2link_rot_(0, 1), imu2link_rot_(0, 2),
                    imu2link_rot_(1, 0), imu2link_rot_(1, 1), imu2link_rot_(1, 2),
                    imu2link_rot_(2, 0), imu2link_rot_(2, 1), imu2link_rot_(2, 2));

        // 声明并获取初始位置参数
        init_pose_.pos(0) = static_cast<float>(nh_->declare_parameter<double>("init_x", config["init_x"].as<double>()));
        init_pose_.pos(1) = static_cast<float>(nh_->declare_parameter<double>("init_y", config["init_y"].as<double>()));
        init_pose_.pos(2) = static_cast<float>(nh_->declare_parameter<double>("init_z", config["init_z"].as<double>()));
        init_pose_.orient(0) = static_cast<float>(nh_->declare_parameter<double>("init_roll", config["init_roll"].as<double>()));
        init_pose_.orient(1) = static_cast<float>(nh_->declare_parameter<double>("init_pitch", config["init_pitch"].as<double>()));
        init_pose_.orient(2) = static_cast<float>(nh_->declare_parameter<double>("init_yaw", config["init_yaw"].as<double>()));

        RCLCPP_INFO(nh_->get_logger(), "Loc: init_pose_: %f, %f, %f, %f, %f, %f", init_pose_.pos(0), init_pose_.pos(1), init_pose_.pos(2), init_pose_.orient(0), init_pose_.orient(1), init_pose_.orient(2));

        update_q(init_pose_);
        act_pose = init_pose_;
        act_pose.vel << 0.0, 0.0, 0.0;

        // 初始化订阅，发布器（直接订阅原始Livox话题）
        std::string lidar_topic = nh_->declare_parameter<std::string>("lidar_topic", config["lidar_topic"].as<std::string>());

        // 防止算法处理慢导致丢帧，同时不会引入过大延迟,LiDAR队列=3: 10Hz频率，算法处理50-80ms，队列3可缓存300ms
        cloud_sub_ = nh_->create_subscription<sensor_msgs::msg::PointCloud2>(
            lidar_topic, 10, std::bind(&location::robosense_cb, this, std::placeholders::_1));
        
        std::string cmd_topic = nh_->declare_parameter<std::string>("cmd_topic", config["cmd_topic"].as<std::string>());
        cmd_sub_ = nh_->create_subscription<std_msgs::msg::String>(cmd_topic, 10, std::bind(&location::command_cb, this, std::placeholders::_1));

        // 单线程executor模式,IMU队列=200: 200Hz频率,队列200可缓存1秒数据,应对处理线程短时繁忙
        std::string imu_topic = nh_->declare_parameter<std::string>("imu_topic", config["imu_topic"].as<std::string>());
        imu_sub_ = nh_->create_subscription<sensor_msgs::msg::Imu>(
            imu_topic, 200, std::bind(&location::imu_cb, this, std::placeholders::_1));

        init_pose_sub_ = nh_->create_subscription<geometry_msgs::msg::PoseWithCovarianceStamped>("/initialpose", 1, std::bind(&location::initpose_cb, this, std::placeholders::_1)); // 手动重定位订阅

        std::string map_pub_topic_ = nh_->declare_parameter<std::string>("map_pub_topic", config["map_pub_topic"].as<std::string>());
        pc_map_pub_ = nh_->create_publisher<sensor_msgs::msg::PointCloud2>(map_pub_topic_, rclcpp::QoS(rclcpp::KeepLast(1)).transient_local().reliable()); // 发布全局pcd点云地图话题数据
        RCLCPP_INFO(nh_->get_logger(), "map_pub_topic_: %s", map_pub_topic_.c_str());

        map_file_path = nh_->declare_parameter<std::string>("map_filename", config["map_filename"].as<std::string>()); // 地图路径
        map_cloud.reset(new pcl::PointCloud<PointType>);
        RCLCPP_INFO(nh_->get_logger(), "Loc: map_file_path file: %s", map_file_path.c_str());

        // 直接加载为PointType类型，避免类型转换循环
        if (pcl::io::loadPCDFile(map_file_path.c_str(), *map_cloud) == -1)
        {
            RCLCPP_ERROR(nh_->get_logger(), "Loc: load map failed %s", map_file_path.c_str());
            return;
        }

        RCLCPP_INFO(nh_->get_logger(), "Loc: map_cloud->size(): %zu", map_cloud->size());

        // 获取地图体素滤波 map_voxelgrid_filter_的尺寸
        voxel_leaf_size_ = config["map_filtr_leaf_size"].as<double>();

        map_voxelgrid_filter_.setLeafSize(voxel_leaf_size_, voxel_leaf_size_, voxel_leaf_size_);
        pcl::PointCloud<PointType>::Ptr map_cloud_filter(new pcl::PointCloud<PointType>);
        map_cloud_filter->clear();

        map_voxelgrid_filter_.setInputCloud(map_cloud);

        map_voxelgrid_filter_.filter(*map_cloud_filter);
        RCLCPP_INFO(nh_->get_logger(), "Loc: map_cloud_filter->points.size(): %zu", map_cloud_filter->points.size());

        map_cloud_filter->width = map_cloud_filter->points.size();

        map_cloud_filter->height = 1;

        // 发布地图
        pcl::toROSMsg(*map_cloud_filter, pubmap_msg);
        if (pubmap_msg.width != 0)
        {
            RCLCPP_INFO(nh_->get_logger(), "Loc: map has been published");
            pubmap_msg.header.frame_id = map_frame_;
            pubmap_msg.header.stamp = nh_->get_clock()->now(); // 设置时间戳
            RCLCPP_INFO(nh_->get_logger(), "Publishing map with timestamp: %.9f", getSec(pubmap_msg.header));
            rclcpp::sleep_for(std::chrono::seconds(2));
            pc_map_pub_->publish(pubmap_msg);
        }
        else
        {
            RCLCPP_ERROR(nh_->get_logger(), " Loc :  can not publish map");
            return;
        }

        localizier3d.reset(new scan2map3d(map_cloud_filter, config_file_name)); // 载入滤波地图
        RCLCPP_INFO(
            nh_->get_logger(),
            "Loc: registration_method: %s",
            localizier3d->registrationMethodName().c_str());

        GlobalRelocalization::Config global_reloc_config;
        global_reloc_config.max_range = config["bbs_max_range"] ? config["bbs_max_range"].as<double>() : 20.0;
        global_reloc_config.min_tx = config["bbs_min_tx"] ? config["bbs_min_tx"].as<double>() : -50.0;
        global_reloc_config.max_tx = config["bbs_max_tx"] ? config["bbs_max_tx"].as<double>() : 50.0;
        global_reloc_config.min_ty = config["bbs_min_ty"] ? config["bbs_min_ty"].as<double>() : -50.0;
        global_reloc_config.max_ty = config["bbs_max_ty"] ? config["bbs_max_ty"].as<double>() : 50.0;
        global_reloc_config.min_theta = config["bbs_min_theta"] ? config["bbs_min_theta"].as<double>() : -M_PI;
        global_reloc_config.max_theta = config["bbs_max_theta"] ? config["bbs_max_theta"].as<double>() : M_PI;
        global_reloc_config.map_min_z = config["bbs_map_min_z"] ? config["bbs_map_min_z"].as<double>() : -0.5;
        global_reloc_config.map_max_z = config["bbs_map_max_z"] ? config["bbs_map_max_z"].as<double>() : 0.8;
        global_reloc_config.scan_min_z = config["bbs_scan_min_z"] ? config["bbs_scan_min_z"].as<double>() : -0.5;
        global_reloc_config.scan_max_z = config["bbs_scan_max_z"] ? config["bbs_scan_max_z"].as<double>() : 0.8;
        global_reloc_config.map_resolution = config["bbs_map_resolution"] ? config["bbs_map_resolution"].as<double>() : 0.5;
        global_reloc_config.map_width = config["bbs_map_width"] ? config["bbs_map_width"].as<int>() : 512;
        global_reloc_config.map_height = config["bbs_map_height"] ? config["bbs_map_height"].as<int>() : 512;
        global_reloc_config.map_pyramid_level = config["bbs_map_pyramid_level"] ? config["bbs_map_pyramid_level"].as<int>() : 6;
        global_reloc_config.max_points_per_cell = config["bbs_max_points_per_cell"] ? config["bbs_max_points_per_cell"].as<int>() : 5;
        global_reloc_config.enable_bounded_window = enable_bounded_global_reloc_window_;
        global_reloc_config.bounded_translation_window =
            config["bbs_bounded_translation_window"] ? config["bbs_bounded_translation_window"].as<double>() : 8.0;
        global_reloc_config.bounded_yaw_window_deg =
            config["bbs_bounded_yaw_window_deg"] ? config["bbs_bounded_yaw_window_deg"].as<double>() : 45.0;
        global_relocalizer_.reset(new GlobalRelocalization(global_reloc_config));
        global_relocalizer_->setGlobalMap(map_cloud_filter);
        if (use_reloc_) {
            localizier3d->setRelocMode();
        } else {
            localizier3d->setNormalMode();
        }

        // 初始化eskf
        std::string eskf_cfg_path;
        nh_->declare_parameter<std::string>("eskf_cfg_file", "none");
        nh_->get_parameter<std::string>("eskf_cfg_file", eskf_cfg_path);
        RCLCPP_INFO(nh_->get_logger(), "eskf_cfg_path: %s", eskf_cfg_path.c_str());
        eskf.reset(new ErrorStateKalmanFilter(eskf_cfg_path));

        std::string pose_pub_topic_ = nh_->declare_parameter<std::string>("pose_pub_topic", config["pose_pub_topic"].as<std::string>());
        pose_pub_ = nh_->create_publisher<geometry_msgs::msg::PoseStamped>(pose_pub_topic_, 10); // 发布定位位姿话题数据
        RCLCPP_INFO(nh_->get_logger(), "pose_pub_topic_: %s", pose_pub_topic_.c_str());

        std::string status_topic = nh_->declare_parameter<std::string>(
            "status_topic",
            config["status_topic"] ? config["status_topic"].as<std::string>() : "/localization_status");
        status_pub_ = nh_->create_publisher<indoor_location::msg::LocalizationStatus>(status_topic, 10);
        RCLCPP_INFO(nh_->get_logger(), "status_topic: %s", status_topic.c_str());

        odom2map_topic_ = nh_->declare_parameter<std::string>(
            "odom2map_topic",
            config["odom2map_topic"] ? config["odom2map_topic"].as<std::string>() : "/odom2map");
        odom2map_pub_ = nh_->create_publisher<nav_msgs::msg::Odometry>(odom2map_topic_, 10);
        RCLCPP_INFO(nh_->get_logger(), "odom2map_topic_: %s", odom2map_topic_.c_str());

        publish_reset_visibility_graph_on_reloc_success_ =
            nh_->declare_parameter<bool>("publish_reset_visibility_graph_on_reloc_success", true);
        reset_visibility_graph_topic_ =
            nh_->declare_parameter<std::string>("reset_visibility_graph_topic", "/reset_visibility_graph");
        reset_visibility_graph_pub_ =
            nh_->create_publisher<std_msgs::msg::Empty>(reset_visibility_graph_topic_, 10);
        RCLCPP_INFO(
            nh_->get_logger(),
            "publish_reset_visibility_graph_on_reloc_success: %s, topic: %s",
            publish_reset_visibility_graph_on_reloc_success_ ? "true" : "false",
            reset_visibility_graph_topic_.c_str());

        // 初始化处理后点云发布器
        std::string processed_cloud_topic = nh_->declare_parameter<std::string>("pub_cloud_topic", config["pub_cloud_topic"].as<std::string>());
        processed_cloud_pub_ = nh_->create_publisher<sensor_msgs::msg::PointCloud2>(processed_cloud_topic, 10);
        RCLCPP_INFO(nh_->get_logger(), "processed_cloud_topic: %s", processed_cloud_topic.c_str());

        pose_persistence_.setPath(
            nh_->declare_parameter<std::string>(
                "pose_persistence_path",
                config["pose_persistence_path"] ? config["pose_persistence_path"].as<std::string>() : "/tmp/indoor_location_last_pose.txt"));
        RCLCPP_INFO(nh_->get_logger(), "pose_persistence_path: %s", pose_persistence_.path().c_str());

        if (enable_pose_restore_) {
            PosePersistence::LoadResult restored_pose;
            if (pose_persistence_.load(restored_pose)) {
                act_pose = restored_pose.pose;
                update_q(act_pose);
                pose_restored_from_disk_ = true;
                restored_pose_pending_ = true;
                use_reloc_ = false;
                initial_global_alignment_done_ = false;
                runtime_reloc_locked_ = false;
                localizier3d->setNormalMode();
                localization_state_ = indoor_location::LocalizationState::kRestoredPosePending;
                last_pose_source_ = "restored";
                RCLCPP_INFO(
                    nh_->get_logger(),
                    "[恢复] 已加载断电前位姿: pos=(%.2f, %.2f, %.2f), yaw=%.1f deg, state=%s, fitness=%.3f",
                    act_pose.pos(0), act_pose.pos(1), act_pose.pos(2),
                    act_pose.orient(2) * 57.3f,
                    restored_pose.state.c_str(),
                    restored_pose.fitness);
            } else {
                localization_state_ = use_reloc_ ? indoor_location::LocalizationState::kGlobalRelocalizing
                                                 : indoor_location::LocalizationState::kUninitialized;
            }
        } else {
            localization_state_ = use_reloc_ ? indoor_location::LocalizationState::kGlobalRelocalizing
                                             : indoor_location::LocalizationState::kUninitialized;
        }

        // 初始化性能统计
        last_pose_publish_time_ = nh_->get_clock()->now();
        stats_start_time_ = nh_->get_clock()->now();

        // ========== 初始化去畸变外参 T_i_l_ (IMU到LiDAR的变换) ==========
        // 从配置文件读取是否启用去畸变
        bool enable_undistort_from_config = config["enable_undistort"].as<bool>(true); // 默认启用
        RCLCPP_INFO(nh_->get_logger(), "[去畸变配置] 配置文件设置: %s",
                    enable_undistort_from_config ? "启用" : "禁用");

        if (!enable_undistort_from_config)
        {
            enable_undistort_ = false;
            RCLCPP_WARN(nh_->get_logger(), "[去畸变] 配置文件已禁用去畸变功能");
        }
        else
        {
            try
            {
                Eigen::Vector3f lidar2base_rpy_init = lidar2base_rpy;
                Eigen::Vector3f lidar2base_trans_init = lidar2base_trans;
                Eigen::Matrix3f lidar2base_rot_init = lidar2base_rot;

                RCLCPP_INFO(nh_->get_logger(), "[去畸变初始化] IMU2Base外参读取完成");
                RCLCPP_INFO(nh_->get_logger(), "[去畸变初始化] Lidar2Base外参读取完成");

                // 计算 T_i_l_ = T_i_b * T_b_l
                // 其中 T_i_b 是 IMU到base的变换，T_b_l 是 base到lidar的变换
                Eigen::Matrix3d imu2base_rot_d = imu2link_rot_.cast<double>();
                Eigen::Vector3d imu2base_trans_d = imu2base_pose.pos.cast<double>();

                // 确保旋转矩阵是正交的
                Eigen::JacobiSVD<Eigen::Matrix3d> svd_imu(imu2base_rot_d, Eigen::ComputeFullU | Eigen::ComputeFullV);
                imu2base_rot_d = svd_imu.matrixU() * svd_imu.matrixV().transpose();

                Sophus::SE3d T_i_b(Sophus::SO3d(imu2base_rot_d), imu2base_trans_d);
                RCLCPP_INFO(nh_->get_logger(), "[去畸变初始化] T_i_b 构造完成");

                Eigen::Matrix3d lidar2base_rot_d = lidar2base_rot_init.cast<double>();
                Eigen::Vector3d lidar2base_trans_d = lidar2base_trans_init.cast<double>();

                // 确保旋转矩阵是正交的
                Eigen::JacobiSVD<Eigen::Matrix3d> svd_lidar(lidar2base_rot_d, Eigen::ComputeFullU | Eigen::ComputeFullV);
                lidar2base_rot_d = svd_lidar.matrixU() * svd_lidar.matrixV().transpose();

                Sophus::SE3d T_b_l(Sophus::SO3d(lidar2base_rot_d), lidar2base_trans_d);
                RCLCPP_INFO(nh_->get_logger(), "[去畸变初始化] T_b_l 构造完成");

                T_i_l_ = T_i_b * T_b_l;
                RCLCPP_INFO(nh_->get_logger(), "[去畸变初始化] 成功! T_i_l_: trans=(%.3f, %.3f, %.3f)",
                            T_i_l_.translation().x(), T_i_l_.translation().y(), T_i_l_.translation().z());

                // 初始化成功后启用去畸变
                enable_undistort_ = true;
                RCLCPP_INFO(nh_->get_logger(), "[去畸变] 功能已启用");
            }
            catch (const std::exception &e)
            {
                RCLCPP_ERROR(nh_->get_logger(), "[去畸变初始化] 失败: %s, 去畸变功能已禁用", e.what());
                enable_undistort_ = false;
            }
        }

        // 创建定时器，每5秒输出一次性能统计
        stats_timer_ = nh_->create_wall_timer(
            std::chrono::seconds(5),
            std::bind(&location::print_performance_stats, this));

        // 启动独立处理线程(专注于同步+定位,点云处理在回调中完成)
        process_thread_ = std::thread(&location::processThreadFunc, this);
    }
    
    // 析构函数:正确关闭处理线程
    ~location()
    {
        RCLCPP_INFO(nh_->get_logger(), "[析构] 开始清理资源...");
        persistPoseNow(nh_->get_clock()->now().seconds(), last_pose_source_);
        
        // 通知处理线程退出
        g_b_exit.store(true);
        process_cv_.notify_all();
        
        // 等待线程结束
        if (process_thread_.joinable()) {
            process_thread_.join();
            RCLCPP_INFO(nh_->get_logger(), "[析构] 处理线程已关闭");
        }
        
        RCLCPP_INFO(nh_->get_logger(), "[析构] 资源清理完成");
    }

    // 性能统计输出函数
    void print_performance_stats()
    {
        if (perf_history_.empty())
            return;

        // 计算平均值
        double avg_imu_predict = 0.0;
        double avg_registration = 0.0;
        double avg_eskf_correct = 0.0;
        double avg_pose_publish = 0.0;
        double avg_total = 0.0;
        double avg_imu_count = 0.0;

        for (const auto &stat : perf_history_)
        {
            avg_imu_predict += stat.imu_predict_time_ms;
            avg_registration += stat.cloud_registration_time_ms;
            avg_eskf_correct += stat.eskf_correct_time_ms;
            avg_pose_publish += stat.pose_publish_time_ms;
            avg_total += stat.total_process_time_ms;
            avg_imu_count += stat.imu_count;
        }

        size_t count = perf_history_.size();
        avg_imu_predict /= count;
        avg_registration /= count;
        avg_eskf_correct /= count;
        avg_pose_publish /= count;
        avg_total /= count;
        avg_imu_count /= count;

        // 计算位姿发布频率
        double elapsed_time = (nh_->get_clock()->now() - stats_start_time_).seconds();
        double pose_pub_freq = (elapsed_time > 0.0) ? (pose_publish_count_ / elapsed_time) : 0.0;

        // 获取最后一帧的数据
        const auto &last_stat = perf_history_.back();

        RCLCPP_INFO(nh_->get_logger(),
                    "\n========== 定位性能统计 (最近%zu帧) ==========\n"
                    "定位频率: %.2f Hz (总共 %d 次)\n"
                    "\n--- 1. 各模块平均耗时 ---\n"
                    "  IMU预积分:     %.2f ms (平均 %.1f 个)\n"
                    "  点云配准:       %.2f ms\n"
                    "  ESKF校正:      %.2f ms\n"
                    "  位姿发布:       %.2f ms\n"
                    "  总处理时间:     %.2f ms\n"
                    "\n--- 2. 最新一帧时间同步详情 ---\n"
                    "  同步状态:       %s\n"
                    "  雷达起始:       %.6f s\n"
                    "  雷达结束:       %.6f s (扫描时长 %.1f ms)\n"
                    "  同步后IMU:     %d 个 (%.6f ~ %.6f s)\n"
                    "  IMU与雷达:     首帧差 %+.1f ms | 末帧差 %+.1f ms\n"
                    "\n--- 同步前缓冲区状态 ---\n"
                    "  IMU缓冲区:     %zu 个 (%.6f ~ %.6f s)\n"
                    "  时间覆盖:       %.1f ms\n"
                    "\n--- 最新一帧耗时 ---\n"
                    "  IMU预积分:     %.2f ms\n"
                    "  点云配准:       %.2f ms\n"
                    "  ESKF校正:      %.2f ms\n"
                    "  位姿发布:       %.2f ms\n"
                    "  总处理:         %.2f ms\n"
                    "==========================================",
                    count, pose_pub_freq, pose_publish_count_,
                    avg_imu_predict, avg_imu_count, avg_registration, avg_eskf_correct, avg_pose_publish, avg_total,
                    last_stat.sync_success ? "成功✓" : "失败✗",
                    last_stat.lidar_start_time,
                    last_stat.lidar_end_time,
                    (last_stat.lidar_end_time - last_stat.lidar_start_time) * 1000.0,
                    last_stat.imu_count,
                    last_stat.imu_first_time,
                    last_stat.imu_last_time,
                    (last_stat.imu_first_time - last_stat.lidar_start_time) * 1000.0,
                    (last_stat.imu_last_time - last_stat.lidar_end_time) * 1000.0,
                    last_stat.imu_buffer_before_sync,
                    last_stat.imu_buffer_first_time,
                    last_stat.imu_buffer_last_time,
                    (last_stat.imu_buffer_last_time - last_stat.imu_buffer_first_time) * 1000.0,
                    last_stat.imu_predict_time_ms, last_stat.cloud_registration_time_ms,
                    last_stat.eskf_correct_time_ms, last_stat.pose_publish_time_ms, last_stat.total_process_time_ms);
    }

    // 发布点云数据到指定话题（参考lio_node.cpp的publishCloud函数）
    void publishCloud(rclcpp::Publisher<sensor_msgs::msg::PointCloud2>::SharedPtr pub,
                      pcl::PointCloud<PointType>::Ptr cloud,
                      const std::string &frame_id,
                      const double &time)
    {
        // 如果没有订阅者则不发布，节省计算资源
        if (pub->get_subscription_count() <= 0)
            return;

        // 将PCL点云转换为ROS消息格式
        sensor_msgs::msg::PointCloud2 cloud_msg;
        pcl::toROSMsg(*cloud, cloud_msg);

        // 设置消息头信息
        cloud_msg.header.frame_id = frame_id;   // 坐标系名称
        cloud_msg.header.stamp = getTime(time); // 时间戳

        // 发布点云消息
        pub->publish(cloud_msg);
    }

    // 发布位姿信息（参考lio_node.cpp的发布模式）
    void publishPose(const std::string &frame_id, const double &time)
    {
        // 如果没有订阅者则不发布
        if (pose_pub_->get_subscription_count() <= 0)
            return;

        // 创建位姿消息
        geometry_msgs::msg::PoseStamped pose_msg;
        pose_msg.header.frame_id = frame_id;
        pose_msg.header.stamp = getTime(time);

        // 设置位置信息
        pose_msg.pose.position.x = act_pose.pos(0);
        pose_msg.pose.position.y = act_pose.pos(1);
        pose_msg.pose.position.z = act_pose.pos(2);

        // 设置姿态信息（从欧拉角转换为四元数）
        tf2::Quaternion q;
        q.setRPY(act_pose.orient(0), act_pose.orient(1), act_pose.orient(2));
        pose_msg.pose.orientation.x = q.x();
        pose_msg.pose.orientation.y = q.y();
        pose_msg.pose.orientation.z = q.z();
        pose_msg.pose.orientation.w = q.w();

        // 发布位姿消息
        pose_pub_->publish(pose_msg);
    }

    bool isPosePersistable() const
    {
        return localization_state_ == indoor_location::LocalizationState::kTrackingOk ||
               (localization_state_ == indoor_location::LocalizationState::kTrackingWeak && has_last_valid_map_to_odom_);
    }

    void publishLocalizationStatus(const double &time)
    {
        if (!status_pub_) {
            return;
        }

        indoor_location::LocalizationStatusSnapshot snapshot;
        snapshot.state = localization_state_;
        snapshot.in_relocalization = use_reloc_ || restored_pose_pending_;
        snapshot.runtime_reloc_locked = runtime_reloc_locked_;
        snapshot.map_to_odom_frozen = map_to_odom_frozen_;
        snapshot.pose_restored_from_disk = pose_restored_from_disk_;
        snapshot.wheel_odom_available = wheel_odom_available_;
        snapshot.fitness = localizier3d ? localizier3d->fitness_ : 0.0f;
        snapshot.raw_fitness = localizier3d ? localizier3d->raw_fitness_ : 0.0f;
        snapshot.reloc_success_count = reloc_success_count_;
        snapshot.tracking_loss_count = tracking_loss_count_;
        snapshot.pose = act_pose;
        status_pub_->publish(
            indoor_location::BuildLocalizationStatusMessage(snapshot, getTime(time), map_frame_));
    }

    void persistPoseNow(const double &time, const std::string &source)
    {
        if (pose_persistence_.path().empty()) {
            return;
        }

        if (pose_save_only_when_stable_ && !isPosePersistable()) {
            return;
        }

        pose_type pose_to_save = act_pose;
        pose_to_save.timestamp = time;
        pose_to_save.status = indoor_location::ToString(localization_state_);
        if (pose_persistence_.save(
                pose_to_save,
                indoor_location::ToString(localization_state_),
                localizier3d ? localizier3d->fitness_ : 0.0f,
                source))
        {
            last_pose_save_time_ = time;
            last_pose_source_ = source;
            last_saved_pose_ = pose_to_save;
            has_last_saved_pose_ = true;
        }
    }

    void maybePersistPose(const double &time)
    {
        if (!PoseSavePolicy::ShouldPersist(
                pose_save_policy_config_,
                act_pose,
                time,
                last_saved_pose_,
                last_pose_save_time_,
                has_last_saved_pose_)) {
            return;
        }
        persistPoseNow(time, last_pose_source_);
    }

    bool runGlobalRelocalization(
        const pcl::PointCloud<PointType>::Ptr &cloud_in,
        pose_type &candidate_pose,
        bool &used_bounded_window)
    {
        used_bounded_window = false;
        if (!global_relocalizer_ || !global_relocalizer_->hasMap() || !cloud_in || cloud_in->empty()) {
            return false;
        }

        GlobalRelocalization::Result coarse_result;
        bool found = false;
        if (enable_bounded_global_reloc_window_) {
            found = global_relocalizer_->localizeNearPose(cloud_in, act_pose, coarse_result);
        }
        if (!found) {
            found = global_relocalizer_->localize(cloud_in, coarse_result);
        }
        if (!found) {
            return false;
        }

        used_bounded_window = coarse_result.used_bounded_window;
        candidate_pose = localizier3d->location(coarse_result.pose, cloud_in);
        return true;
    }

    // 广播TF变换信息（参考lio_node.cpp的broadCastTF函数）
    void broadCastTF(const std::string &frame_id, const std::string &child_frame, const double &time)
    {
        // 创建TF变换消息
        geometry_msgs::msg::TransformStamped transformStamped;
        transformStamped.header.frame_id = frame_id;   // 父坐标系
        transformStamped.child_frame_id = child_frame; // 子坐标系
        transformStamped.header.stamp = getTime(time); // 时间戳

        // 设置平移信息
        transformStamped.transform.translation.x = act_pose.pos(0);
        transformStamped.transform.translation.y = act_pose.pos(1);
        transformStamped.transform.translation.z = act_pose.pos(2);

        // 设置旋转信息（从欧拉角转换为四元数）
        tf2::Quaternion q;
        q.setRPY(act_pose.orient(0), act_pose.orient(1), act_pose.orient(2));
        transformStamped.transform.rotation.x = q.x();
        transformStamped.transform.rotation.y = q.y();
        transformStamped.transform.rotation.z = q.z();
        transformStamped.transform.rotation.w = q.w();

        // 广播TF变换
        tf_broadcaster_->sendTransform(transformStamped);
    }

    bool computeMapToOdomTransform(const double &time, geometry_msgs::msg::TransformStamped &map_to_odom)
    {
        geometry_msgs::msg::TransformStamped odom_to_base;
        const auto stamp = getTime(time);

        try
        {
            odom_to_base = tf_buffer_->lookupTransform(
                odom_frame_,
                base_frame_,
                stamp,
                tf2::durationFromSec(0.05));
        }
        catch (const tf2::TransformException &ex)
        {
            try
            {
                odom_to_base = tf_buffer_->lookupTransform(
                    odom_frame_,
                    base_frame_,
                    tf2::TimePointZero,
                    tf2::durationFromSec(0.05));
            }
            catch (const tf2::TransformException &fallback_ex)
            {
                wheel_odom_available_ = false;
                RCLCPP_WARN_THROTTLE(
                    nh_->get_logger(),
                    *nh_->get_clock(),
                    2000,
                    "Cannot build TF %s->%s, waiting for %s->%s: %s",
                    map_frame_.c_str(),
                    odom_frame_.c_str(),
                    odom_frame_.c_str(),
                    base_frame_.c_str(),
                    fallback_ex.what());
                return false;
            }
        }
        wheel_odom_available_ = true;

        tf2::Transform tf_map_base;
        tf2::Quaternion q_map_base;
        q_map_base.setRPY(act_pose.orient(0), act_pose.orient(1), act_pose.orient(2));
        tf_map_base.setOrigin(tf2::Vector3(act_pose.pos(0), act_pose.pos(1), act_pose.pos(2)));
        tf_map_base.setRotation(q_map_base);

        tf2::Transform tf_odom_base;
        tf2::fromMsg(odom_to_base.transform, tf_odom_base);

        const tf2::Transform tf_map_odom = tf_map_base * tf_odom_base.inverse();

        map_to_odom.header.frame_id = map_frame_;
        map_to_odom.child_frame_id = odom_frame_;
        map_to_odom.header.stamp = stamp;
        map_to_odom.transform = tf2::toMsg(tf_map_odom);
        return true;
    }

    void publishOdom2MapMessage(const geometry_msgs::msg::TransformStamped &map_to_odom)
    {
        nav_msgs::msg::Odometry message;
        message.header = map_to_odom.header;
        message.child_frame_id = map_to_odom.child_frame_id;
        message.pose.pose.position.x = map_to_odom.transform.translation.x;
        message.pose.pose.position.y = map_to_odom.transform.translation.y;
        message.pose.pose.position.z = map_to_odom.transform.translation.z;
        message.pose.pose.orientation = map_to_odom.transform.rotation;
        odom2map_pub_->publish(message);
    }

    void publishRelocSuccessReset()
    {
        if (!publish_reset_visibility_graph_on_reloc_success_ || !reset_visibility_graph_pub_) {
            return;
        }
        std_msgs::msg::Empty message;
        reset_visibility_graph_pub_->publish(message);
        RCLCPP_WARN(
            nh_->get_logger(),
            "[重定位] 已发布 %s，通知 FAR 重新生成 vgraph",
            reset_visibility_graph_topic_.c_str());
    }

    bool broadCastMapToOdomTF(const double &time)
    {
        if (freeze_map_to_odom_after_init_ && runtime_reloc_locked_ && has_last_valid_map_to_odom_)
        {
            map_to_odom_frozen_ = true;
            geometry_msgs::msg::TransformStamped frozen_map_to_odom = last_valid_map_to_odom_;
            frozen_map_to_odom.header.stamp = getTime(time);
            tf_broadcaster_->sendTransform(frozen_map_to_odom);
            publishOdom2MapMessage(frozen_map_to_odom);
            return true;
        }

        geometry_msgs::msg::TransformStamped map_to_odom;
        if (!computeMapToOdomTransform(time, map_to_odom))
        {
            return false;
        }
        map_to_odom_frozen_ = false;
        if (initial_global_alignment_done_ && has_last_valid_map_to_odom_)
        {
            const auto &prev = last_valid_map_to_odom_.transform.translation;
            const auto &curr = map_to_odom.transform.translation;
            const double dx = curr.x - prev.x;
            const double dy = curr.y - prev.y;
            const double dz = curr.z - prev.z;
            const double translation_step = std::sqrt(dx * dx + dy * dy + dz * dz);

            tf2::Quaternion q_prev;
            tf2::Quaternion q_curr;
            tf2::fromMsg(last_valid_map_to_odom_.transform.rotation, q_prev);
            tf2::fromMsg(map_to_odom.transform.rotation, q_curr);
            double prev_roll = 0.0;
            double prev_pitch = 0.0;
            double prev_yaw = 0.0;
            double curr_roll = 0.0;
            double curr_pitch = 0.0;
            double curr_yaw = 0.0;
            tf2::Matrix3x3(q_prev).getRPY(prev_roll, prev_pitch, prev_yaw);
            tf2::Matrix3x3(q_curr).getRPY(curr_roll, curr_pitch, curr_yaw);
            const double yaw_step_deg =
                std::abs(std::remainder(curr_yaw - prev_yaw, 2.0 * M_PI)) * 57.2957795;

            if (translation_step > map_to_odom_max_translation_step_m_ ||
                yaw_step_deg > map_to_odom_max_yaw_step_deg_)
            {
                map_to_odom_frozen_ = true;
                geometry_msgs::msg::TransformStamped frozen_map_to_odom = last_valid_map_to_odom_;
                frozen_map_to_odom.header.stamp = getTime(time);
                tf_broadcaster_->sendTransform(frozen_map_to_odom);
                publishOdom2MapMessage(frozen_map_to_odom);
                RCLCPP_WARN_THROTTLE(
                    nh_->get_logger(),
                    *nh_->get_clock(),
                    1000,
                    "[map->odom] 检测到大步跳变，冻结上一帧有效解: dpos=%.3f m, dyaw=%.2f deg",
                    translation_step,
                    yaw_step_deg);
                return true;
            }
        }
        last_valid_map_to_odom_ = map_to_odom;
        has_last_valid_map_to_odom_ = true;
        tf_broadcaster_->sendTransform(map_to_odom);
        publishOdom2MapMessage(map_to_odom);
        return true;
    }

    bool lookupOdomToBaseTransform(const double &time, geometry_msgs::msg::TransformStamped &odom_to_base)
    {
        try
        {
            odom_to_base = tf_buffer_->lookupTransform(
                odom_frame_,
                base_frame_,
                getTime(time),
                tf2::durationFromSec(0.02));
        }
        catch (const tf2::TransformException &ex)
        {
            try
            {
                odom_to_base = tf_buffer_->lookupTransform(
                    odom_frame_,
                    base_frame_,
                    tf2::TimePointZero,
                    tf2::durationFromSec(0.02));
            }
            catch (const tf2::TransformException &fallback_ex)
            {
                wheel_odom_available_ = false;
                RCLCPP_WARN_THROTTLE(
                    nh_->get_logger(),
                    *nh_->get_clock(),
                    2000,
                    "[运动判定] 等待 TF %s->%s: %s",
                    odom_frame_.c_str(),
                    base_frame_.c_str(),
                    fallback_ex.what());
                return false;
            }
        }
        wheel_odom_available_ = true;
        return true;
    }

    bool lookupOdomToBasePose(const double &time, Eigen::Vector3f &position, float &yaw)
    {
        geometry_msgs::msg::TransformStamped odom_to_base;
        if (!lookupOdomToBaseTransform(time, odom_to_base))
        {
            return false;
        }

        position(0) = static_cast<float>(odom_to_base.transform.translation.x);
        position(1) = static_cast<float>(odom_to_base.transform.translation.y);
        position(2) = static_cast<float>(odom_to_base.transform.translation.z);

        tf2::Quaternion q;
        tf2::fromMsg(odom_to_base.transform.rotation, q);
        double roll = 0.0;
        double pitch = 0.0;
        double yaw_double = 0.0;
        tf2::Matrix3x3(q).getRPY(roll, pitch, yaw_double);
        yaw = static_cast<float>(yaw_double);
        return true;
    }

    bool updateMotionStateFromOdomTF(const double &time)
    {
        Eigen::Vector3f current_pos = Eigen::Vector3f::Zero();
        float current_yaw = 0.0f;
        if (!lookupOdomToBasePose(time, current_pos, current_yaw))
        {
            return last_motion_is_stationary_;
        }

        if (!motion_state_initialized_)
        {
            motion_state_initialized_ = true;
            last_motion_is_stationary_ = true;
            last_motion_eval_pos_ = current_pos;
            last_motion_eval_yaw_ = current_yaw;
            last_motion_eval_time_ = time;
            return true;
        }

        const double dt = time - last_motion_eval_time_;
        if (dt <= 1e-3)
        {
            return last_motion_is_stationary_;
        }

        const Eigen::Vector3f delta = current_pos - last_motion_eval_pos_;
        const double linear_speed = static_cast<double>(delta.norm()) / dt;
        const double yaw_delta = std::abs(std::remainder(
            static_cast<double>(current_yaw - last_motion_eval_yaw_), 2.0 * M_PI));
        const double yaw_rate = yaw_delta / dt;
        const bool is_stationary =
            linear_speed <= stationary_linear_speed_threshold_mps_ &&
            yaw_rate <= stationary_yaw_rate_threshold_radps_;

        if (is_stationary != last_motion_is_stationary_)
        {
            RCLCPP_INFO(
                nh_->get_logger(),
                "[运动判定] 状态切换: %s -> %s | v=%.3f m/s, wz=%.3f rad/s",
                last_motion_is_stationary_ ? "静止" : "运动",
                is_stationary ? "静止" : "运动",
                linear_speed,
                yaw_rate);
        }

        last_motion_is_stationary_ = is_stationary;
        last_motion_eval_pos_ = current_pos;
        last_motion_eval_yaw_ = current_yaw;
        last_motion_eval_time_ = time;
        return is_stationary;
    }

    void resetMotionState()
    {
        motion_state_initialized_ = false;
        last_motion_is_stationary_ = true;
        last_motion_eval_pos_.setZero();
        last_motion_eval_yaw_ = 0.0f;
        last_motion_eval_time_ = 0.0;
    }

    bool syncActPoseWithFrozenMapToOdom(const double &time)
    {
        if (!has_last_valid_map_to_odom_)
        {
            return false;
        }

        geometry_msgs::msg::TransformStamped odom_to_base;
        if (!lookupOdomToBaseTransform(time, odom_to_base))
        {
            return false;
        }

        tf2::Transform tf_map_odom;
        tf2::Transform tf_odom_base;
        tf2::fromMsg(last_valid_map_to_odom_.transform, tf_map_odom);
        tf2::fromMsg(odom_to_base.transform, tf_odom_base);
        const tf2::Transform tf_map_base = tf_map_odom * tf_odom_base;

        const tf2::Vector3 origin = tf_map_base.getOrigin();
        act_pose.pos(0) = static_cast<float>(origin.x());
        act_pose.pos(1) = static_cast<float>(origin.y());
        act_pose.pos(2) = static_cast<float>(origin.z());

        double roll = 0.0;
        double pitch = 0.0;
        double yaw = 0.0;
        tf2::Matrix3x3(tf_map_base.getRotation()).getRPY(roll, pitch, yaw);
        act_pose.orient(0) = static_cast<float>(roll);
        act_pose.orient(1) = static_cast<float>(pitch);
        act_pose.orient(2) = static_cast<float>(yaw);
        update_q(act_pose);
        return true;
    }

    bool trySeedPoseFromOdomTF()
    {
        if (seeded_from_odom_tf_) {
            return true;
        }

        const bool pose_is_zero =
            std::abs(act_pose.pos(0)) < 1e-4 && std::abs(act_pose.pos(1)) < 1e-4 &&
            std::abs(act_pose.pos(2)) < 1e-4 && std::abs(act_pose.orient(0)) < 1e-4 &&
            std::abs(act_pose.orient(1)) < 1e-4 && std::abs(act_pose.orient(2)) < 1e-4;
        if (!pose_is_zero) {
            seeded_from_odom_tf_ = true;
            return true;
        }

        try
        {
            const auto odom_to_base = tf_buffer_->lookupTransform(
                odom_frame_,
                base_frame_,
                tf2::TimePointZero,
                tf2::durationFromSec(0.05));

            act_pose.pos(0) = static_cast<float>(odom_to_base.transform.translation.x);
            act_pose.pos(1) = static_cast<float>(odom_to_base.transform.translation.y);
            act_pose.pos(2) = static_cast<float>(odom_to_base.transform.translation.z);

            tf2::Quaternion q;
            tf2::fromMsg(odom_to_base.transform.rotation, q);
            double roll, pitch, yaw;
            tf2::Matrix3x3(q).getRPY(roll, pitch, yaw);
            act_pose.orient(0) = static_cast<float>(roll);
            act_pose.orient(1) = static_cast<float>(pitch);
            act_pose.orient(2) = static_cast<float>(yaw);
            update_q(act_pose);
            resetMotionState();

            seeded_from_odom_tf_ = true;
            RCLCPP_INFO(
                nh_->get_logger(),
                "[初始化] 使用 TF %s->%s 作为 indoor_location 初始位姿: pos=(%.2f, %.2f, %.2f), rpy=(%.1f, %.1f, %.1f)",
                odom_frame_.c_str(),
                base_frame_.c_str(),
                act_pose.pos(0), act_pose.pos(1), act_pose.pos(2),
                act_pose.orient(0) * 57.3f, act_pose.orient(1) * 57.3f, act_pose.orient(2) * 57.3f);
            return true;
        }
        catch (const tf2::TransformException &ex)
        {
            RCLCPP_WARN_THROTTLE(
                nh_->get_logger(),
                *nh_->get_clock(),
                2000,
                "[初始化] 等待 TF %s->%s 作为 indoor_location 初始位姿: %s",
                odom_frame_.c_str(),
                base_frame_.c_str(),
                ex.what());
            return false;
        }
    }

    // IMU回调函数（完全对齐lio_node.cpp的逻辑）
    void imu_cb(const sensor_msgs::msg::Imu::SharedPtr imu_msg)
    {
        // 【锁前】记录回调开始时间
        double sys_time_before_lock = nh_->get_clock()->now().seconds();
        double msg_timestamp = getSec(imu_msg->header);
        double delay_before_lock = sys_time_before_lock - msg_timestamp;
        
        // 时间戳诊断打印（每200帧打印一次）
        static int imu_diag_count = 0;
        bool should_print = (++imu_diag_count % 200 == 0);
        
        if (should_print)
        {
            RCLCPP_INFO(nh_->get_logger(), 
                       "[IMU-锁前] 消息时间=%.6f | 系统时间=%.6f | 延迟=%.3fs(%.0fms)",
                       msg_timestamp, sys_time_before_lock, delay_before_lock, delay_before_lock * 1000.0);
        }
        
        // 加锁保护IMU缓冲区
        std::lock_guard<std::mutex> lock(m_state_data.imu_mutex);
        
        // // 【锁后】记录获取锁后的时间
        // double sys_time_after_lock = nh_->get_clock()->now().seconds();
        // double lock_wait_time = sys_time_after_lock - sys_time_before_lock;
        // double delay_after_lock = sys_time_after_lock - msg_timestamp;
        
        // if (should_print)
        // {
        //     RCLCPP_INFO(nh_->get_logger(), 
        //                "[IMU-锁后] 系统时间=%.6f | 等锁耗时=%.1fms | 总延迟=%.3fs(%.0fms)",
        //                sys_time_after_lock, lock_wait_time * 1000.0, 
        //                delay_after_lock, delay_after_lock * 1000.0);
        // }
        
        double timestamp = msg_timestamp; // 使用消息时间戳

        // 检测时间戳乱序（与lio_node一致）
        if (timestamp < m_state_data.last_imu_time)
        {
            RCLCPP_WARN(nh_->get_logger(), "IMU Message is out of order");
            std::deque<IMUData>().swap(m_state_data.imu_buffer);
        }

        // 第1步：读取原始IMU数据（与lio_node一致使用Vector3d）
        Eigen::Vector3d acc(imu_msg->linear_acceleration.x,
                            imu_msg->linear_acceleration.y,
                            imu_msg->linear_acceleration.z);
        Eigen::Vector3d gyro(imu_msg->angular_velocity.x,
                             imu_msg->angular_velocity.y,
                             imu_msg->angular_velocity.z);

        // 第2步：坐标系旋转到base_link（与lio_node一致）
        acc = imu2link_rot_.cast<double>() * acc;
        gyro = imu2link_rot_.cast<double>() * gyro;

        // 第3步：检查加速度Z值，判断单位并进行转换（与lio_node完全一致）
        // 如果线性加速度的z分量 > 5，认为单位是m/s²，需要转换为g（除以9.81）
        if (acc.z() > 5.0)
        {
            acc = acc / imu_scale_;

            // 调试：记录单位转换后的数据
            // if (enable_sync_debug_ && raw_imu_counter % 200 == 0)
            // {
            //     RCLCPP_INFO(nh_->get_logger(),
            //                 "[IMU变换] 单位转换(÷9.81)后: 加速度=[%.6f,%.6f,%.6f]g",
            //                 acc.x(), acc.y(), acc.z());
            // }
        }
        else if (acc.z() < 0)
        {
            // 特殊处理：速腾airy 96线雷达，数据转到雷达坐标系，imu坐标系朝下
            acc = Eigen::Vector3d(-acc.y(), -acc.x(), -acc.z());
            gyro = Eigen::Vector3d(-gyro.y(), -gyro.x(), -gyro.z());
        }
        else
        {
            // -5 < z < 5，认为已经是g单位，不需要转换
            acc = acc;
        }

        // 第4步：最终缓存数据，乘以imu_scale_转换为m/s²（与lio_node完全一致）
        Eigen::Vector3d final_acc = acc * imu_scale_;

        // 调试：记录最终缓存的数据
        // if (enable_sync_debug_ && raw_imu_counter % 200 == 0)
        // {
        //     RCLCPP_INFO(nh_->get_logger(),
        //                 "[IMU变换] 最终缓存(×%.1f)后: 加速度=[%.6f,%.6f,%.6f]m/s²",
        //                 imu_scale_, final_acc.x(), final_acc.y(), final_acc.z());
        // }

        // 添加到缓冲区（与lio_node一致）
        m_state_data.imu_buffer.emplace_back(final_acc, gyro, timestamp);

        // 更新最新的IMU时间戳
        m_state_data.last_imu_time = timestamp;
        
        // // 【结束时】记录回调结束时间
        // double sys_time_end = nh_->get_clock()->now().seconds();
        // double process_time = sys_time_end - sys_time_after_lock;
        // double total_delay = sys_time_end - msg_timestamp;
        
        // if (should_print)
        // {
        //     RCLCPP_INFO(nh_->get_logger(), 
        //                "[IMU-结束] 系统时间=%.6f | 处理耗时=%.1fms | 总延迟=%.3fs(%.0fms) | 缓冲区=%zu个",
        //                sys_time_end, process_time * 1000.0, 
        //                total_delay, total_delay * 1000.0,
        //                m_state_data.imu_buffer.size());
        // }
    }

    // 激光点云回调 - 最优版:直接处理点云,然后唤醒定位线程
    void robosense_cb(const sensor_msgs::msg::PointCloud2::SharedPtr cloud_msg)
    {
        // 获取时间戳
        double msg_timestamp = getSec(cloud_msg->header);
        double sys_timestamp = nh_->get_clock()->now().seconds();
        double time_diff = sys_timestamp - msg_timestamp;
        
        // 时间戳诊断打印（每200帧一次，避免刷屏）
        static uint64_t lidar_cb_count = 0;
        if (++lidar_cb_count % 200 == 0) {
            RCLCPP_INFO(nh_->get_logger(), 
                       "[LiDAR回调] 消息时间=%.6f | 系统时间=%.6f | 差值=%.3fs(%.0fms)",
                       msg_timestamp, sys_timestamp, time_diff, time_diff * 1000.0);
        }
        
        // === 步骤1: 点云处理(在回调线程中,不阻塞IMU因为是单线程executor) ===
        auto process_start = std::chrono::high_resolution_clock::now();
        
        pcl::PointCloud<PointType>::Ptr processed_cloud;
        if (lidar_type_ == "livox") {
            processed_cloud = livox_processor_->livox_cloud_handler(cloud_msg);
        } else if (lidar_type_ == "rs16") {
            processed_cloud = rs16_processor_->rs16_handler(cloud_msg);
        } else {
            RCLCPP_ERROR(nh_->get_logger(), "[LiDAR回调] 未知雷达类型: %s", lidar_type_.c_str());
            return;
        }
        
        auto process_end = std::chrono::high_resolution_clock::now();
        double process_time_ms = std::chrono::duration<double, std::milli>(
            process_end - process_start).count();

        if (!processed_cloud)
        {
            RCLCPP_WARN_THROTTLE(
                nh_->get_logger(),
                *nh_->get_clock(),
                2000,
                "[LiDAR回调] 点云预处理返回空指针，丢弃该帧");
            return;
        }

        if (processed_cloud->empty())
        {
            RCLCPP_WARN_THROTTLE(
                nh_->get_logger(),
                *nh_->get_clock(),
                2000,
                "[LiDAR回调] 点云预处理结果为空，丢弃该帧");
            return;
        }
        
        // === 步骤2: 加入同步队列(锁粒度小) ===
        {
            std::lock_guard<std::mutex> lock(m_state_data.lidar_mutex);
            
            // 检测时间戳乱序
            if (msg_timestamp < m_state_data.last_lidar_time) {
                RCLCPP_WARN(nh_->get_logger(), "[LiDAR回调] 消息乱序,清空缓冲");
                std::deque<std::pair<double, pcl::PointCloud<PointType>::Ptr>>().swap(
                    m_state_data.lidar_buffer);
            }
            
            m_state_data.lidar_buffer.emplace_back(msg_timestamp, processed_cloud);
            m_state_data.last_lidar_time = msg_timestamp;
            
            // 记录处理时间用于诊断
            RCLCPP_DEBUG(nh_->get_logger(), "[LiDAR回调] 点云处理耗时=%.1fms", process_time_ms);
        }
        
        // === 步骤3: 唤醒处理线程尝试同步 ===
        // 注意: 处理线程会在wait_for中调用syncPackage()判断是否真的能同步
        process_cv_.notify_one();
    }

    // 同步IMU和LiDAR数据包（完全对齐lio_node.cpp的逻辑）
    bool syncPackage()
    {
        // 如果IMU缓冲区或LiDAR缓冲区为空，无法同步（与lio_node一致）
        if (m_state_data.imu_buffer.empty() || m_state_data.lidar_buffer.empty())
            return false;

        // 如果还未处理当前帧雷达数据
        if (!m_state_data.lidar_pushed)
        {
            // 取出当前帧雷达点云
            m_package.cloud = m_state_data.lidar_buffer.front().second;

            if (!m_package.cloud)
            {
                RCLCPP_WARN_THROTTLE(
                    nh_->get_logger(),
                    *nh_->get_clock(),
                    2000,
                    "[同步] 收到空指针点云，丢弃当前帧");
                m_state_data.lidar_buffer.pop_front();
                m_state_data.lidar_pushed = false;
                return false;
            }

            if (m_package.cloud->points.empty())
            {
                RCLCPP_WARN_THROTTLE(
                    nh_->get_logger(),
                    *nh_->get_clock(),
                    2000,
                    "[同步] 收到空点云，丢弃当前帧");
                m_state_data.lidar_buffer.pop_front();
                m_state_data.lidar_pushed = false;
                return false;
            }

            // 按照点的曲率（curvature）排序（与lio_node一致）
            std::sort(m_package.cloud->points.begin(), m_package.cloud->points.end(),
                      [](PointType &p1, PointType &p2)
                      { return p1.curvature < p2.curvature; });

            // 设置当前点云开始时间（由lidar_buffer的时间戳确定）
            m_package.cloud_start_time = m_state_data.lidar_buffer.front().first;

            // 设置当前点云的结束时间：开始时间 + 最后一个点的曲率（毫秒转秒）
            // 通常曲率字段被复用为点的相对时间（毫秒），因此除以1000变成秒
            m_package.cloud_end_time = m_package.cloud_start_time +
                                       m_package.cloud->points.back().curvature / 1000.0;

            // 标记lidar已经处理
            m_state_data.lidar_pushed = true;
        }

        // 丢弃这帧点云,等待下一帧(参考Livox的SyncMeasure)
        // if (m_state_data.imu_buffer.front().time > m_package.cloud_start_time)
        // {
        //     RCLCPP_WARN(nh_->get_logger(), 
        //                "[同步] IMU数据不足: IMU首帧(%.6f) > 点云开始(%.6f), 丢弃点云帧",
        //                m_state_data.imu_buffer.front().time, m_package.cloud_start_time);
        //     m_state_data.lidar_buffer.pop_front();
        //     m_state_data.lidar_pushed = false;  // 【关键】必须重置标志,否则下次不会取新点云
        //     return false;
        // }

        // 如果最新的IMU时间还没有覆盖到当前点云的结束时间，则等待更多的IMU数据
        if (m_state_data.last_imu_time < m_package.cloud_end_time)
            return false;

        // 清空上一帧打包的IMU数据（与lio_node一致使用Vec<IMUData>().swap()）
        std::vector<IMUData>().swap(m_package.imus);

        // 将所有时间 < 点云结束时间的IMU数据打包进m_package.imus（与lio_node完全一致）
        while (!m_state_data.imu_buffer.empty() &&
               m_state_data.imu_buffer.front().time < m_package.cloud_end_time)
        {
            m_package.imus.emplace_back(m_state_data.imu_buffer.front());
            m_state_data.imu_buffer.pop_front(); // 从队列中弹出已使用的IMU数据
        }

        // 移除已处理的雷达数据帧
        m_state_data.lidar_buffer.pop_front();
        m_state_data.lidar_pushed = false;

        // 数据包同步成功
        return true;
    }

    // 初始位 姿反馈
    void initpose_cb(const geometry_msgs::msg::PoseWithCovarianceStamped::SharedPtr pose_msg)
    {

        RCLCPP_INFO(nh_->get_logger(), "get hand init pose!");
        act_pose.pos(0) = pose_msg->pose.pose.position.x;
        act_pose.pos(1) = pose_msg->pose.pose.position.y;
        act_pose.pos(2) = 0.0;

        // yaw (z-axis rotation)
        double siny_cosp = 2.0 * pose_msg->pose.pose.orientation.w * pose_msg->pose.pose.orientation.z;
        double cosy_cosp = 1.0 - 2.0 * pose_msg->pose.pose.orientation.z * pose_msg->pose.pose.orientation.z;

        act_pose.orient(0) = 0.0;
        act_pose.orient(1) = 0.0;
        act_pose.orient(2) = atan2(siny_cosp, cosy_cosp);

        act_pose.vel << 0.0, 0.0, 0.0;
        use_reloc_ = true;
        restored_pose_pending_ = false;
        reloc_success_count_ = 0;
        tracking_loss_count_ = 0;
        has_last_reloc_candidate_ = false;
        initial_global_alignment_done_ = false;
        runtime_reloc_locked_ = false;
        has_last_valid_map_to_odom_ = false;
        pose_restored_from_disk_ = false;
        localization_state_ = indoor_location::LocalizationState::kGlobalRelocalizing;
        last_pose_source_ = "manual_init";
        resetMotionState();

        // 重置ESKF状态
        eskf->setMean(act_pose.pos.cast<double>(), act_pose.orient.cast<double>(), act_pose.vel.cast<double>());
        eskf->reset();
    }

    // 状态命 令反馈
    void command_cb(const std_msgs::msg::String::SharedPtr msg)
    {
        RCLCPP_INFO(nh_->get_logger(), "cmd: %s", msg->data.c_str());
        if (msg->data == "shutdown")
        {
            rclcpp::shutdown();
        }
        else if (msg->data == "test_reloc")
        {

            RCLCPP_INFO(nh_->get_logger(), "test reloc");
            act_pose.pos(0) = act_pose.pos(0) + 5.0;
            act_pose.pos(1) = 4.0;
        }
    }


    void imu_predict(const std::vector<IMUData> &imus, PerformanceStats &perf_stat)
    {
        if (imus.empty())
        {
            perf_stat.imu_predict_time_ms = 0.0;
            return;
        }

        auto imu_predict_start = std::chrono::high_resolution_clock::now();

        for (const auto &imu : imus)
        {
            Eigen::VectorXd imu_data(6);
            imu_data << imu.acc, imu.gyro;

            if (check_imu_data(imu_data))
            {
                eskf->predict(imu_data, imu.time);
                eskf->getPose(act_pose);
            }
        }

        auto imu_predict_end = std::chrono::high_resolution_clock::now();
        perf_stat.imu_predict_time_ms = std::chrono::duration<double, std::milli>(imu_predict_end - imu_predict_start).count();
    }

    // ============ 去畸变相关函数 ============

    // IMU插值函数（参考gyr_int.cpp）
    IMUData interpolateImu(const IMUData &imu1, const IMUData &imu2, double t)
    {
        if (std::abs(imu2.time - imu1.time) < 1e-9)
        {
            return imu1;
        }

        double ratio = (t - imu1.time) / (imu2.time - imu1.time);
        double w1 = 1.0 - ratio;
        double w2 = ratio;

        IMUData imu_inter;
        imu_inter.acc = w1 * imu1.acc + w2 * imu2.acc;
        imu_inter.gyro = w1 * imu1.gyro + w2 * imu2.gyro;
        imu_inter.time = t;

        return imu_inter;
    }

    // 角速度积分函数（参考gyr_int.cpp的Integrate函数）
    Sophus::SO3d integrateRotation(double start_time, double end_time,
                                   const std::vector<IMUData> &v_imu)
    {
        Sophus::SO3d result_rot; // 初始化为单位旋转

        if (v_imu.empty() || start_time >= end_time)
        {
            return result_rot;
        }

        // 找到第一个时间大于等于start_time的IMU数据
        size_t start_idx = 0;
        for (size_t i = 0; i < v_imu.size(); ++i)
        {
            if (v_imu[i].time >= start_time)
            {
                start_idx = (i > 0) ? i - 1 : 0;
                break;
            }
        }

        // 找到最后一个时间小于等于end_time的IMU数据
        size_t end_idx = v_imu.size() - 1;
        for (size_t i = v_imu.size(); i > 0; --i)
        {
            if (v_imu[i - 1].time <= end_time)
            {
                end_idx = i - 1;
                break;
            }
        }

        if (start_idx >= v_imu.size() || end_idx >= v_imu.size() || start_idx > end_idx)
        {
            return result_rot;
        }

        // 在start_time处插值
        IMUData current_imu;
        double current_time = start_time;

        if (start_idx == 0)
        {
            current_imu = v_imu[0];
        }
        else
        {
            current_imu = interpolateImu(v_imu[start_idx - 1], v_imu[start_idx], start_time);
        }

        // 开始积分
        for (size_t i = start_idx; i <= end_idx; ++i)
        {
            double next_time = v_imu[i].time;

            if (next_time > end_time)
            {
                // 在end_time处插值并处理最后一个区间
                double prev_time = (i > 0) ? v_imu[i - 1].time : start_time;
                IMUData end_imu = interpolateImu(v_imu[i - 1], v_imu[i], end_time);

                // 积分最后一个区间
                double dt = end_time - current_time;
                Eigen::Vector3d delta_angle = dt * 0.5 * (current_imu.gyro + end_imu.gyro);
                Sophus::SO3d delta_r = Sophus::SO3d::exp(delta_angle);
                result_rot = result_rot * delta_r;

                break;
            }
            else
            {
                // 积分当前区间
                double dt = next_time - current_time;
                Eigen::Vector3d delta_angle = dt * 0.5 * (current_imu.gyro + v_imu[i].gyro);
                Sophus::SO3d delta_r = Sophus::SO3d::exp(delta_angle);
                result_rot = result_rot * delta_r;

                // 更新当前状态
                current_time = next_time;
                current_imu = v_imu[i];
            }
        }

        // 处理end_time在所有IMU数据之后的情况
        if (end_time > v_imu.back().time)
        {
            double dt = end_time - current_time;
            Eigen::Vector3d delta_angle = dt * current_imu.gyro;
            Sophus::SO3d delta_r = Sophus::SO3d::exp(delta_angle);
            result_rot = result_rot * delta_r;
        }

        return result_rot;
    }

    // 点云去畸变函数（参考data_process.cpp的UndistortPcl）
    void undistortPointCloud(pcl::PointCloud<PointType>::Ptr &cloud,
                             double start_time, double end_time,
                             const std::vector<IMUData> &imus)
    {
        if (!enable_undistort_ || imus.empty() || cloud->empty())
        {
            return;
        }

        auto undistort_start = std::chrono::high_resolution_clock::now();

        // 积分IMU数据，计算从扫描开始到结束的旋转
        Sophus::SO3d rot_i_be = integrateRotation(start_time, end_time, imus);

        // 计算从扫描开始到结束的变换（只考虑旋转，平移为零）
        Sophus::SE3d T_i_be(rot_i_be, Eigen::Vector3d::Zero());

        // 转换到激光雷达坐标系: T_l_be = T_l_i * T_i_be * T_i_l
        Sophus::SE3d T_l_be = T_i_l_.inverse() * T_i_be * T_i_l_;

        const Eigen::Vector3d &tbe = T_l_be.translation();
        Eigen::Vector3d rso3_be = T_l_be.so3().log();
        double dt_be = end_time - start_time;

        if (dt_be <= 0)
        {
            RCLCPP_ERROR(nh_->get_logger(), "[去畸变] 无效的时间跨度: start=%.6f, end=%.6f",
                         start_time, end_time);
            return;
        }

        // 对每个点进行去畸变
        for (auto &pt : cloud->points)
        {
            // curvature字段存储相对时间（毫秒）
            double dt_bi = pt.curvature / 1000.0; // 转换为秒

            if (dt_bi < 0 || dt_bi > dt_be)
            {
                // 时间戳异常，使用均匀分布
                continue;
            }

            double ratio_bi = dt_bi / dt_be;
            double ratio_ie = 1.0 - ratio_bi;

            // 计算从当前点时刻到扫描结束的旋转和平移
            Eigen::Vector3d rso3_ie = ratio_ie * rso3_be;
            Sophus::SO3d Rie = Sophus::SO3d::exp(rso3_ie);
            Eigen::Vector3d tie = ratio_ie * tbe;

            // 运动补偿：将点从当前时刻变换到扫描结束时刻
            Eigen::Vector3d v_pt_i(pt.x, pt.y, pt.z);
            Eigen::Vector3d v_pt_comp_e = Rie.inverse() * (v_pt_i - tie);

            // 更新点坐标
            pt.x = v_pt_comp_e.x();
            pt.y = v_pt_comp_e.y();
            pt.z = v_pt_comp_e.z();
        }

        auto undistort_end = std::chrono::high_resolution_clock::now();
        auto duration = std::chrono::duration_cast<std::chrono::microseconds>(undistort_end - undistort_start);

        // 去畸变信息（每200帧一次，避免刷屏）
        static uint64_t undistort_log_count = 0;
        if (++undistort_log_count % 200 == 0) {
            RCLCPP_INFO(nh_->get_logger(),
                        "[去畸变] 点云数=%zu | IMU数=%zu | 耗时=%.2fms | 旋转角度=(%.2f°, %.2f°, %.2f°) | 时间跨度=%.1fms",
                        cloud->size(), imus.size(), duration.count() / 1000.0,
                        T_l_be.angleX() * 180.0 / M_PI,
                        T_l_be.angleY() * 180.0 / M_PI,
                        T_l_be.angleZ() * 180.0 / M_PI,
                        (end_time - start_time) * 1000.0);
        }
    }

    // ============ 独立处理线程函数 ============
    void processThreadFunc()
    {
        RCLCPP_INFO(nh_->get_logger(), "[处理线程] 启动,使用同步触发模式(参考Livox)");
        
        int process_count = 0; // 处理帧计数
        
        while (rclcpp::ok() && !g_b_exit.load())
        {
            // === 关键改进: 等待同步成功而非简单的数据到达 ===
            // 参考Livox的ProcessLoop: wait_for + SyncMeasure作为条件
            {
                std::unique_lock<std::mutex> lock(process_mutex_);
                
                // 等待条件: syncPackage()成功 或 收到退出信号
                // 使用wait_for(10ms)避免在异常情况下永久阻塞
                if (!process_cv_.wait_for(lock, std::chrono::milliseconds(10),
                    [this]() { 
                        // 退出信号优先
                        if (g_b_exit.load()) return true;
                        // 尝试同步IMU和LiDAR,成功则唤醒处理
                        return syncPackage();
                    }))
                {
                    // 超时(同步失败),继续等待
                    continue;
                }
                
                // 检查是否是退出信号
                if (g_b_exit.load()) {
                    RCLCPP_INFO(nh_->get_logger(), "[处理线程] 收到退出信号");
                    break;
                }
                
                // 到这里说明syncPackage()成功,数据已在m_package中
            }
            
            // === 步骤2: 执行完整的定位算法(数据已同步) ===
            PerformanceStats perf_stat;
            auto frame_start_time = std::chrono::high_resolution_clock::now();
            
            // 记录时间同步信息
            perf_stat.sync_success = true;
            perf_stat.lidar_start_time = m_package.cloud_start_time;
            perf_stat.lidar_end_time = m_package.cloud_end_time;
            perf_stat.imu_count = static_cast<int>(m_package.imus.size());
            
            if (!m_package.imus.empty()) {
                perf_stat.imu_first_time = m_package.imus.front().time;
                perf_stat.imu_last_time = m_package.imus.back().time;
            }
            
            // 记录缓冲区状态
            {
                std::lock_guard<std::mutex> lock(m_state_data.imu_mutex);
                perf_stat.imu_buffer_before_sync = m_state_data.imu_buffer.size();
                if (!m_state_data.imu_buffer.empty()) {
                    perf_stat.imu_buffer_first_time = m_state_data.imu_buffer.front().time;
                    perf_stat.imu_buffer_last_time = m_state_data.imu_buffer.back().time;
                }
            }
            
            pcl::PointCloud<PointType>::Ptr cloud_in = m_package.cloud;
            if (!cloud_in || cloud_in->empty())
            {
                RCLCPP_WARN_THROTTLE(
                    nh_->get_logger(),
                    *nh_->get_clock(),
                    2000,
                    "[处理线程] 同步后的点云无效，跳过当前帧");
                std::vector<IMUData>().swap(m_package.imus);
                m_package.cloud.reset();
                continue;
            }
            bool should_publish = false;
            const bool robot_stationary = updateMotionStateFromOdomTF(m_package.cloud_end_time);
            const bool allow_reloc_commit_without_stationary_gate = !initial_global_alignment_done_;
            const bool reloc_commit_allowed = allow_reloc_commit_without_stationary_gate || robot_stationary;
            bool used_bounded_window = false;

            if (restored_pose_pending_) {
                auto reg_start = std::chrono::high_resolution_clock::now();
                pose_type restored_candidate = localizier3d->location(act_pose, cloud_in);
                auto reg_end = std::chrono::high_resolution_clock::now();
                perf_stat.cloud_registration_time_ms =
                    std::chrono::duration<double, std::milli>(reg_end - reg_start).count();

                if (localizier3d->fitness_ >= tracking_threshold_) {
                    act_pose = restored_candidate;
                    update_q(act_pose);
                    restored_pose_pending_ = false;
                    use_reloc_ = false;
                    tracking_loss_count_ = 0;
                    // 同上: 提交新全局位姿后强制重算 map->odom
                    has_last_valid_map_to_odom_ = false;
                    map_to_odom_frozen_ = false;
                    initial_global_alignment_done_ = true;
                    runtime_reloc_locked_ = disable_runtime_reloc_after_init_;
                    localization_state_ = indoor_location::LocalizationState::kTrackingOk;
                    last_pose_source_ = "restored";
                    eskf->setMean(act_pose.pos.cast<double>(), act_pose.orient.cast<double>(), act_pose.vel.cast<double>());
                    eskf->reset();
                    should_publish = true;
                    RCLCPP_INFO(
                        nh_->get_logger(),
                        "[恢复] 保存位姿验证成功，进入 tracking: fitness=%.3f",
                        localizier3d->fitness_);
                } else {
                    restored_pose_pending_ = false;
                    use_reloc_ = true;
                    localizier3d->setRelocMode();
                    localization_state_ = indoor_location::LocalizationState::kGlobalRelocalizing;
                    should_publish = false;
                    RCLCPP_WARN(
                        nh_->get_logger(),
                        "[恢复] 保存位姿验证失败，切回全局重定位: fitness=%.3f < %.3f",
                        localizier3d->fitness_,
                        tracking_threshold_);
                }
            } else if (use_reloc_) {
                trySeedPoseFromOdomTF();
                localization_state_ = indoor_location::LocalizationState::kGlobalRelocalizing;

                auto reg_start = std::chrono::high_resolution_clock::now();
                pose_type candidate_pose = act_pose;
                const bool reloc_found = runGlobalRelocalization(cloud_in, candidate_pose, used_bounded_window);
                auto reg_end = std::chrono::high_resolution_clock::now();
                perf_stat.cloud_registration_time_ms =
                    std::chrono::duration<double, std::milli>(reg_end - reg_start).count();

                if (reloc_found && localizier3d->fitness_ >= reloc_threshold_) {
                    bool reloc_candidate_stable = true;
                    if (has_last_reloc_candidate_) {
                        const float dx = candidate_pose.pos(0) - last_reloc_candidate_pose_.pos(0);
                        const float dy = candidate_pose.pos(1) - last_reloc_candidate_pose_.pos(1);
                        const float dz = candidate_pose.pos(2) - last_reloc_candidate_pose_.pos(2);
                        const float pos_delta = std::sqrt(dx * dx + dy * dy + dz * dz);
                        const float yaw_delta_deg = std::abs(
                            static_cast<float>(
                                std::remainder(
                                    static_cast<double>(candidate_pose.orient(2) - last_reloc_candidate_pose_.orient(2)),
                                    2.0 * M_PI))) * 57.2957795f;
                        reloc_candidate_stable =
                            pos_delta <= reloc_stability_pos_threshold_ &&
                            yaw_delta_deg <= reloc_stability_yaw_threshold_deg_;
                        if (!reloc_candidate_stable) {
                            RCLCPP_WARN_THROTTLE(
                                nh_->get_logger(),
                                *nh_->get_clock(),
                                1000,
                                "[重定位] 候选位姿不稳定，丢弃本次确认: dpos=%.2f m, dyaw=%.1f deg",
                                pos_delta,
                                yaw_delta_deg);
                        }
                    }

                    last_reloc_candidate_pose_ = candidate_pose;
                    has_last_reloc_candidate_ = true;

                    if (!reloc_commit_allowed) {
                        reloc_success_count_ = 0;
                        RCLCPP_WARN_THROTTLE(
                            nh_->get_logger(),
                            *nh_->get_clock(),
                            1000,
                            "[重定位] 候选命中但机器人仍在运动，冻结当前 map->odom: fitness=%.3f",
                            localizier3d->fitness_);
                        should_publish = true;
                    } else if (reloc_candidate_stable) {
                        reloc_success_count_++;
                    } else {
                        reloc_success_count_ = 1;
                    }

                    if (reloc_commit_allowed && reloc_success_count_ >= reloc_confirm_frames_) {
                        act_pose = candidate_pose;
                        update_q(act_pose);
                        tracking_loss_count_ = 0;
                        localization_state_ = indoor_location::LocalizationState::kTrackingOk;
                        last_pose_source_ = "bbs_reloc";
                        // 重定位提交: 旧 map->odom 是基于播种位姿算的(常为恒等), 必须失效重算
                        has_last_valid_map_to_odom_ = false;
                        map_to_odom_frozen_ = false;
                        RCLCPP_WARN(
                            nh_->get_logger(),
                            "[重定位] 成功: fitness=%.3f raw=%.3f, pos=(%.2f, %.2f, %.2f), bounded=%s",
                            localizier3d->fitness_,
                            localizier3d->raw_fitness_,
                            act_pose.pos(0),
                            act_pose.pos(1),
                            act_pose.pos(2),
                            used_bounded_window ? "true" : "false");
                        publishRelocSuccessReset();
                        if (use_tracking_mode_) {
                            use_reloc_ = false;
                            reloc_success_count_ = 0;
                            has_last_reloc_candidate_ = false;
                            initial_global_alignment_done_ = true;
                            runtime_reloc_locked_ = disable_runtime_reloc_after_init_;
                            localizier3d->setNormalMode();
                            eskf->setMean(act_pose.pos.cast<double>(), act_pose.orient.cast<double>(), act_pose.vel.cast<double>());
                            eskf->reset();
                        }
                        should_publish = true;
                    } else {
                        RCLCPP_WARN_THROTTLE(
                            nh_->get_logger(),
                            *nh_->get_clock(),
                            1000,
                            "[重定位] 命中阈值，等待稳定确认: fitness=%.3f raw=%.3f, count=%d/%d, bounded=%s",
                            localizier3d->fitness_,
                            localizier3d->raw_fitness_,
                            reloc_success_count_,
                            reloc_confirm_frames_,
                            used_bounded_window ? "true" : "false");
                        should_publish = true;
                    }
                } else {
                    reloc_success_count_ = 0;
                    has_last_reloc_candidate_ = false;
                    localization_state_ = indoor_location::LocalizationState::kLost;
                    RCLCPP_WARN_THROTTLE(
                        nh_->get_logger(),
                        *nh_->get_clock(),
                        2000,
                        "[重定位] 进行中: found=%s fitness=%.3f raw=%.3f (阈值=%.3f)",
                        reloc_found ? "true" : "false",
                        localizier3d->fitness_,
                        localizier3d->raw_fitness_,
                        reloc_threshold_);
                }
            } else {
                if (freeze_map_to_odom_after_init_ && runtime_reloc_locked_ && has_last_valid_map_to_odom_) {
                    if (!syncActPoseWithFrozenMapToOdom(m_package.cloud_end_time)) {
                        RCLCPP_WARN_THROTTLE(
                            nh_->get_logger(),
                            *nh_->get_clock(),
                            1000,
                            "[定位] 冻结模式下无法通过 odom 恢复全局位姿，保持上一帧 act_pose");
                    }
                    tracking_loss_count_ = 0;
                    localization_state_ = indoor_location::LocalizationState::kTrackingOk;
                    should_publish = true;
                } else {
                    if (use_wheel_odom_prior_ && has_last_valid_map_to_odom_) {
                        syncActPoseWithFrozenMapToOdom(m_package.cloud_end_time);
                    }

                    if (!m_package.imus.empty()) {
                        undistortPointCloud(cloud_in, m_package.cloud_start_time,
                                           m_package.cloud_end_time, m_package.imus);
                    }

                    if (!m_package.imus.empty()) {
                        imu_predict(m_package.imus, perf_stat);
                    }

                    auto reg_start = std::chrono::high_resolution_clock::now();
                    act_pose = localizier3d->location(act_pose, cloud_in);
                    auto reg_end = std::chrono::high_resolution_clock::now();
                    perf_stat.cloud_registration_time_ms =
                        std::chrono::duration<double, std::milli>(reg_end - reg_start).count();

                    if (!m_package.imus.empty()) {
                        auto eskf_start = std::chrono::high_resolution_clock::now();
                        eskf->correct(act_pose);
                        auto eskf_end = std::chrono::high_resolution_clock::now();
                        perf_stat.eskf_correct_time_ms =
                            std::chrono::duration<double, std::milli>(eskf_end - eskf_start).count();
                    }

                    if (localizier3d->fitness_ < tracking_threshold_) {
                        tracking_loss_count_++;
                        localization_state_ = indoor_location::LocalizationState::kTrackingWeak;
                        if (runtime_reloc_locked_) {
                            RCLCPP_WARN_THROTTLE(
                                nh_->get_logger(),
                                *nh_->get_clock(),
                                1000,
                                "[定位] Tracking fitness 偏低，但运行时重定位已锁定，继续依赖里程计追踪: %.3f < %.3f, loss=%d/%d",
                                localizier3d->fitness_,
                                tracking_threshold_,
                                tracking_loss_count_,
                                tracking_loss_frames_);
                            should_publish = true;
                        } else if (auto_reloc_on_tracking_loss_ && tracking_loss_count_ >= tracking_loss_frames_) {
                            if (robot_stationary) {
                                RCLCPP_WARN(
                                    nh_->get_logger(),
                                    "[定位] 连续%d帧 Fitness过低 (最新=%.3f < %.3f)，且机器人静止，切换重定位",
                                    tracking_loss_count_,
                                    localizier3d->fitness_,
                                    tracking_threshold_);
                                use_reloc_ = true;
                                reloc_success_count_ = 0;
                                tracking_loss_count_ = 0;
                                has_last_reloc_candidate_ = false;
                                localizier3d->setRelocMode();
                                localization_state_ = indoor_location::LocalizationState::kGlobalRelocalizing;
                                should_publish = false;
                            } else {
                                should_publish = true;
                            }
                        } else {
                            should_publish = true;
                        }
                    } else {
                        tracking_loss_count_ = 0;
                        localization_state_ = indoor_location::LocalizationState::kTrackingOk;
                        last_pose_source_ = "tracking";
                        should_publish = true;
                    }
                }
            }
            
            auto frame_end_time = std::chrono::high_resolution_clock::now();
            perf_stat.total_process_time_ms = 
                std::chrono::duration<double, std::milli>(frame_end_time - frame_start_time).count();
            
            // === 步骤4: 发布位姿 ===
            if (should_publish) {
                if (std::isnan(act_pose.pos(0)) || std::isnan(act_pose.pos(1)) || 
                    std::isnan(act_pose.pos(2))) {
                    RCLCPP_ERROR(nh_->get_logger(), "[处理线程] 检测到NaN位姿,跳过发布");
                } else {
                    auto pub_start = std::chrono::high_resolution_clock::now();
                    // 发布位姿、TF和点云
                    pose_publish_count_++;
                    publishPose(map_frame_, m_package.cloud_end_time);
                    broadCastMapToOdomTF(m_package.cloud_end_time);
                    publishCloud(processed_cloud_pub_, cloud_in, base_frame_, 
                                m_package.cloud_end_time);
                    maybePersistPose(m_package.cloud_end_time);
                    
                    auto pub_end = std::chrono::high_resolution_clock::now();
                    perf_stat.pose_publish_time_ms = 
                        std::chrono::duration<double, std::milli>(pub_end - pub_start).count();
                    
                    // 定期打印发布信息（每20帧）
                    if (pose_publish_count_ % 20 == 0) {
                        RCLCPP_INFO(nh_->get_logger(),
                                   "[位姿发布] 第%d帧 | 时间戳=%.6f | pos=(%.3f, %.3f, %.3f) | rpy=(%.3f°, %.3f°, %.3f°)",
                                   pose_publish_count_,
                                   m_package.cloud_end_time,
                                   act_pose.pos(0), act_pose.pos(1), act_pose.pos(2),
                                   act_pose.orient(0) * 57.3, act_pose.orient(1) * 57.3, act_pose.orient(2) * 57.3);
                    }
                }
            }
            publishLocalizationStatus(m_package.cloud_end_time);
            
            // 更新性能统计
            perf_history_.push_back(perf_stat);
            if (perf_history_.size() > perf_history_size_) {
                perf_history_.pop_front();
            }
            
            // 清理数据
            std::vector<IMUData>().swap(m_package.imus);
            m_package.cloud.reset();
            
            // 打印处理信息
            ++process_count;
            ++undistort_count_;
            
            double current_system_time = nh_->get_clock()->now().seconds();
            double cloud_to_system_delay = current_system_time - m_package.cloud_end_time;
            
            const bool reg_active = perf_stat.cloud_registration_time_ms > 1.0;
            if (reg_active || process_count % 500 == 0) {
            RCLCPP_INFO(nh_->get_logger(),
                       "[第%d帧] 同步云末=%.6f | 系统时间=%.6f | "
                       "数据延迟=%.3fs(%.0fms) | 算法=%.1fms | IMU=%d个 | 配准=%.1fms | "
                       "fitness=%.3f | pos=(%.2f,%.2f,%.2f) | yaw=%.1f°",
                       process_count,
                       m_package.cloud_end_time, current_system_time,
                       cloud_to_system_delay, cloud_to_system_delay * 1000.0,
                       perf_stat.total_process_time_ms, perf_stat.imu_count,
                       perf_stat.cloud_registration_time_ms,
                       localizier3d->fitness_,
                       act_pose.pos(0), act_pose.pos(1), act_pose.pos(2),
                       act_pose.orient(2) * 57.3);
            }
        }
        
        RCLCPP_INFO(nh_->get_logger(), "[处理线程] 退出");
    }
};
int main(int argc, char **argv)
{
    // 初始化ROS2客户端库
    rclcpp::init(argc, argv);
    
    // 注册信号处理函数(Ctrl+C优雅退出)
    signal(SIGINT, SigHandle);
    
    RCLCPP_INFO(rclcpp::get_logger("lidar_location_3d"), 
               "\033[1;32m---->\033[0m Lidar Location 3D Started (多线程+数据驱动模式)");
    
    // 创建节点
    auto nh = rclcpp::Node::make_shared("lidar_location_3d");
    
    // 创建location对象(自动初始化订阅器、发布器和处理线程)
    location loc(nh);

    // 线程数=2: 一个处理IMU(高频200Hz),一个处理LiDAR(低频10Hz)，使用多线程executor,允许IMU和LiDAR回调并发执行
    rclcpp::executors::MultiThreadedExecutor executor(
        rclcpp::ExecutorOptions(), 
        2  // 2个工作线程足够(IMU+LiDAR)
    );
    executor.add_node(nh);
    executor.spin();


    // 使用单线程executor(回调顺序执行,无锁竞争)
    // rclcpp::spin(nh);
    
    RCLCPP_INFO(rclcpp::get_logger("lidar_location_3d"), "正在关闭...");
    
    // 关闭ROS2节点
    rclcpp::shutdown();
    
    RCLCPP_INFO(rclcpp::get_logger("lidar_location_3d"), "已安全退出");
    return 0;
}

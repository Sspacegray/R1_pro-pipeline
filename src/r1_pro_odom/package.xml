<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>r1_pro_odom</name>
  <version>0.1.0</version>
  <description>Odom and TF publisher for R1 Pro using robot_localization (EKF fusing IMU + chassis)</description>
  <maintainer email="dev@galaxea.com">nvidia</maintainer>
  <license>Apache-2.0</license>

  <depend>robot_localization</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>rclpy</depend>
  <depend>localization_msg</depend>
  <depend>std_msgs</depend>
  <depend>hdas_msg</depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>localization</exec_depend>
  <exec_depend>ros2launch</exec_depend>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

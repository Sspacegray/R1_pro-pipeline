#!/usr/bin/env bash
set -eo pipefail

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
CONTAINER_NAME="${R1PRO_CONTAINER:-ros2_humble_gpu}"
if [[ "${1:-}" != "--inside-container" ]]; then
  docker start "$CONTAINER_NAME" >/dev/null
  exec docker exec "$CONTAINER_NAME" bash "$SCRIPT_PATH" --inside-container
fi

source /opt/ros/humble/setup.bash
source /home/pc10/r1pro_web_colcon/install/setup.bash
export ROS_DOMAIN_ID=102
export ROS_LOCALHOST_ONLY=0
export RMW_IMPLEMENTATION=rmw_fastrtps_cpp
export FASTRTPS_DEFAULT_PROFILES_FILE=/home/pc10/r1pro_web_colcon/install/r1pro_web_control/share/r1pro_web_control/config/fastdds_workstation_udp.xml
export FASTDDS_DEFAULT_PROFILES_FILE="$FASTRTPS_DEFAULT_PROFILES_FILE"
export RMW_FASTRTPS_USE_QOS_FROM_XML=1
unset ROS_DISCOVERY_SERVER

python3 - <<'PY'
import fcntl
import os
from pathlib import Path
import signal
import subprocess
import time

project = Path('/home/pc10/桌面/r1pro-web-control-stack')
logs = Path('/tmp/r1pro_aruco_stack')
logs.mkdir(exist_ok=True)
lock = (logs / 'startup.lock').open('w')
fcntl.flock(lock, fcntl.LOCK_EX)

def running_nodes(executable):
    result = []
    for entry in Path('/proc').iterdir():
        if not entry.name.isdigit():
            continue
        try:
            args = (entry / 'cmdline').read_bytes().split(b'\0')
            if not any(Path(arg.decode(errors='replace')).name == executable for arg in args):
                continue
            env = dict(item.split(b'=', 1) for item in (entry / 'environ').read_bytes().split(b'\0') if b'=' in item)
            if env.get(b'ROS_DOMAIN_ID', b'0') == b'102':
                result.append(int(entry.name))
        except (FileNotFoundError, PermissionError, ProcessLookupError):
            continue
    return result

nodes = [
    ('ArUco 识别', 'aruco_box_pose.py', 'r1pro_aruco_box_pose', 'aruco_box_pose.launch.py',
     project / 'src/r1pro_aruco_box_pose/config/head_left_aruco_box_pose.yaml'),
    ('底盘微调', 'aruco_fine_approach', 'r1pro_aruco_fine_approach', 'aruco_fine_approach.launch.py',
     project / 'src/r1pro_aruco_fine_approach/config/aruco_fine_approach.yaml'),
]

# Check both packages and configurations before starting either process.
for label, executable, package, launch, config in nodes:
    if not config.is_file():
        raise SystemExit(f'缺少配置：{config}')
    subprocess.run(['ros2', 'pkg', 'prefix', package], check=True, stdout=subprocess.DEVNULL)

started = []
try:
    for label, executable, package, launch, config in nodes:
        existing = running_nodes(executable)
        if len(existing) > 1:
            raise RuntimeError(f'{label} 已有多个进程 {existing}，请先关闭重复节点')
        if existing:
            print(f'{label}：复用现有节点 PID={existing[0]}', flush=True)
            continue
        log_path = logs / f'{package}.log'
        with log_path.open('ab', buffering=0) as log:
            proc = subprocess.Popen(
                ['ros2', 'launch', package, launch, f'config_file:={config}'],
                stdin=subprocess.DEVNULL, stdout=log, stderr=log,
                start_new_session=True,
            )
        started.append(proc)
        deadline = time.monotonic() + 12
        while time.monotonic() < deadline:
            if proc.poll() is not None:
                raise RuntimeError(f'{label} 启动失败，请查看 {log_path}')
            if running_nodes(executable):
                time.sleep(1)
                if proc.poll() is not None:
                    raise RuntimeError(f'{label} 启动失败，请查看 {log_path}')
                print(f'{label}：已后台启动，日志 {log_path}', flush=True)
                break
            time.sleep(0.25)
        else:
            raise RuntimeError(f'{label} 启动超时，请查看 {log_path}')
except BaseException:
    for proc in started:
        if proc.poll() is None:
            os.killpg(proc.pid, signal.SIGINT)
    raise

print('两个节点已运行，ROS_DOMAIN_ID=102。此脚本不发送微调启用命令。')
print('需要移动时，在相同 ROS 环境执行：')
print('ros2 topic pub --once /r1pro_aruco_fine_approach/enable std_msgs/msg/Bool "{data: true}"')
PY
